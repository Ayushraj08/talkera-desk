---
import '../styles/global.css';
import site from '@content/site.json';
import pricing from '@content/pricing.json';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
}

const {
  title = "Talkera Desk | Answer more customer calls",
  description = "Talkera Desk answers calls, books jobs and texts your team. Set up for restoration, plumbing, HVAC and electrical businesses.",
  canonicalUrl = site.canonicalUrl,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/logo-icon.png" />

    <!-- Search Engine & Regional Geo Targeting (US, UK, CA, AU, IN) -->
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="geo.region" content="US;GB;CA;AU;IN" />
    <meta name="geo.placename" content="United States, United Kingdom, Canada, Australia, India" />
    <meta name="coverage" content="Worldwide" />
    <meta name="audience" content="Contractors, restoration companies, plumbers, HVAC technicians, electricians, tradespeople, tradies, service businesses" />

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={site.brandName} />
    <meta property="og:image" content="https://www.talkeradesk.com/logo.png" />

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://www.talkeradesk.com/logo.png" />

    <!-- International Regional Alternates -->
    <link rel="alternate" hreflang="en-US" href="https://www.talkeradesk.com/" />
    <link rel="alternate" hreflang="en-GB" href="https://www.talkeradesk.com/" />
    <link rel="alternate" hreflang="en-CA" href="https://www.talkeradesk.com/" />
    <link rel="alternate" hreflang="en-AU" href="https://www.talkeradesk.com/" />
    <link rel="alternate" hreflang="en-IN" href="https://www.talkeradesk.com/" />
    <link rel="alternate" hreflang="x-default" href="https://www.talkeradesk.com/" />

    <!-- Inter for body text; Plus Jakarta Sans for headings. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Rich JSON-LD Structured Data for Search & AI Answer Engines -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://www.talkeradesk.com/#organization",
          "name": site.brandName,
          "alternateName": ["Talkera", "TalkeraDesk", "Talkera Desk AI"],
          "url": site.canonicalUrl,
          "logo": "https://www.talkeradesk.com/logo.png",
          "sameAs": Object.values(site.socials).filter(Boolean),
          "areaServed": [
            {"@type": "Country", "name": "United States", "identifier": "US"},
            {"@type": "Country", "name": "United Kingdom", "identifier": "GB"},
            {"@type": "Country", "name": "Canada", "identifier": "CA"},
            {"@type": "Country", "name": "Australia", "identifier": "AU"},
            {"@type": "Country", "name": "India", "identifier": "IN"}
          ],
          "contactPoint": {
            "@type": "ContactPoint",
            "email": site.supportEmail,
            "telephone": site.whatsapp,
            "contactType": "customer service",
            "availableLanguage": "English"
          }
        },
        {
          "@type": "Service",
          "@id": "https://www.talkeradesk.com/#service",
          "name": "Talkera Desk AI Receptionist & Voice Answering",
          "serviceType": "Inbound Call Answering, 24/7 AI Receptionist, Emergency Triage, Automated Calendar Booking",
          "description": "AI phone agent for trade & service businesses. Answers calls 24/7, books appointments into your calendar or CRM, and texts crew dispatch notes.",
          "provider": {"@id": "https://www.talkeradesk.com/#organization"},
          "areaServed": ["US", "GB", "CA", "AU", "IN"],
          "hasOfferCatalog": {
            "@type": "OfferCatalog",
            "name": "Talkera Desk Plans",
            "itemListElement": pricing.plans.map((plan) => ({
              "@type": "Offer",
              "name": plan.name,
              "priceCurrency": "USD",
              "price": String(plan.monthlyFee),
              "description": `${plan.includedMin || plan.minutes || 0} included minutes, ${plan.concurrentCalls || plan.calls} simultaneous calls`,
              "url": "https://www.talkeradesk.com/pricing"
            }))
          }
        },
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            {"@type": "ListItem", "position": 1, "name": "Home", "item": site.canonicalUrl},
            ...(canonicalUrl === site.canonicalUrl ? [] : [{"@type": "ListItem", "position": 2, "name": title, "item": canonicalUrl}])
          ]
        }
      ]
    })} />
  </head>
  <body class="bg-white text-ink antialiased selection:bg-brand-green selection:text-white">
    <!-- Top Sticky Blur Navbar (64px) -->
    <header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 backdrop-blur-md bg-white/95 border-b border-sky-blue/50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-2">
        <!-- Logo Lockup -->
        <a href="/" class="flex items-center gap-2 group min-w-0 shrink py-1" aria-label="Talkera Desk">
          <img
            src="/logo.png"
            alt="Talkera Desk"
            class="h-10 sm:h-11 md:h-12 w-auto max-h-12 object-contain transition-transform duration-200 group-hover:scale-[1.02]"
            width="200"
            height="44"
            loading="eager"
          />
        </a>

        <!-- Desktop Navigation Links -->
        <nav class="hidden md:flex items-center gap-5 lg:gap-7 text-sm lg:text-[15px] font-medium text-slate shrink-0">
          <a href="/how-it-works" class="hover:text-deep-green transition-colors">How it works</a>
          <a href="/pricing" class="hover:text-deep-green transition-colors">Pricing</a>
          
          <!-- Industries Dropdown -->
          <div class="relative group">
            <button type="button" class="flex items-center gap-1 hover:text-deep-green transition-colors py-2 focus:outline-none" aria-expanded="false">
              <span>Industries</span>
              <svg class="w-4 h-4 transition-transform group-hover:rotate-180 text-slate" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="m6 9 6 6 6-6"/>
              </svg>
            </button>
            <div class="absolute top-full left-0 w-72 bg-white rounded-2xl shadow-mercury border border-sky-blue p-2.5 hidden group-hover:block transition-all z-50">
              <a href="/water-damage-restoration" class="flex items-start gap-3 p-3 rounded-xl hover:bg-paper hover:border hover:border-sky-blue/50 transition-colors">
                <div class="w-8 h-8 rounded-lg bg-deep-green/10 text-deep-green flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/>
                  </svg>
                </div>
                <div>
                  <div class="font-semibold text-sm text-ink-deep">Water Damage & Restoration</div>
                </div>
              </a>
              <a href="/plumbing-hvac-electrical" class="flex items-start gap-3 p-3 rounded-xl hover:bg-paper hover:border hover:border-sky-blue/50 transition-colors">
                <div class="w-8 h-8 rounded-lg bg-brand-green/10 text-brand-green flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
                  </svg>
                </div>
                <div>
                  <div class="font-semibold text-sm text-ink-deep">Plumbing, HVAC & Electrical</div>
                </div>
              </a>
            </div>
          </div>

          <a href="/integrations" class="hover:text-deep-green transition-colors">Integrations</a>
          <a href="/compare" class="hover:text-deep-green transition-colors">Compare</a>
          <a href="/faq" class="hover:text-deep-green transition-colors">FAQ</a>
        </nav>

        <!-- Right CTA Buttons -->
        <div class="hidden sm:flex items-center gap-3 lg:gap-4 shrink-0">
          <a href="/demo" class="text-xs lg:text-sm font-semibold text-slate hover:text-ink-deep transition-colors px-2 py-1">
            Demo Library
          </a>
          <a href="/pricing" class="inline-flex items-center justify-center px-4 lg:px-5 py-2 lg:py-2.5 rounded-full text-xs lg:text-sm font-bold bg-deep-green text-white hover:bg-brand-green transition-all shadow-sm hover:shadow active:scale-95">
            View Plans
          </a>
        </div>

        <!-- Mobile Hamburger Button -->
        <button id="mobile-menu-btn" type="button" class="md:hidden p-2 text-ink-deep hover:bg-paper rounded-xl focus:outline-none border border-transparent hover:border-sky-blue shrink-0" aria-label="Toggle mobile menu" aria-expanded="false">
          <svg id="hamburger-icon" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16m-7 6h7"/>
          </svg>
          <svg id="close-icon" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <!-- Mobile Clean & Minimal Drawer Menu -->
      <div id="mobile-menu" class="hidden md:hidden bg-white/98 backdrop-blur-xl border-b border-sky-blue px-6 py-6 transition-all shadow-2xl max-h-[calc(100dvh-4.5rem)] overflow-y-auto">
        <nav class="flex flex-col space-y-1 text-left">
          <a href="/how-it-works" class="py-2.5 px-3 rounded-xl text-base font-semibold text-ink-deep hover:bg-light-blue/40 transition-colors text-left w-full block">
            How It Works
          </a>
          <a href="/pricing" class="py-2.5 px-3 rounded-xl text-base font-semibold text-ink-deep hover:bg-light-blue/40 transition-colors text-left w-full block">
            Pricing & Plans
          </a>
          <a href="/water-damage-restoration" class="py-2.5 px-3 rounded-xl text-base font-semibold text-ink-deep hover:bg-light-blue/40 transition-colors text-left w-full block">
            Water Damage Restoration
          </a>
          <a href="/plumbing-hvac-electrical" class="py-2.5 px-3 rounded-xl text-base font-semibold text-ink-deep hover:bg-light-blue/40 transition-colors text-left w-full block">
            Plumbing, HVAC & Electrical
          </a>
          <a href="/integrations" class="py-2.5 px-3 rounded-xl text-base font-semibold text-ink-deep hover:bg-light-blue/40 transition-colors text-left w-full block">
            Integrations
          </a>
          <a href="/compare" class="py-2.5 px-3 rounded-xl text-base font-semibold text-ink-deep hover:bg-light-blue/40 transition-colors text-left w-full block">
            Compare Solutions
          </a>
          <a href="/demo" class="py-2.5 px-3 rounded-xl text-base font-semibold text-ink-deep hover:bg-light-blue/40 transition-colors text-left w-full block">
            Recorded Demos
          </a>
          <a href="/faq" class="py-2.5 px-3 rounded-xl text-base font-semibold text-ink-deep hover:bg-light-blue/40 transition-colors text-left w-full block">
            FAQ
          </a>
          <a href="/about" class="py-2.5 px-3 rounded-xl text-base font-semibold text-ink-deep hover:bg-light-blue/40 transition-colors text-left w-full block">
            About DRUVA GROUP
          </a>
        </nav>

        <!-- Two Perfectly Aligned & Centered CTAs -->
        <div class="mt-6 pt-5 border-t border-sky-blue/60 flex flex-col gap-3">
          <a href="/demo" class="w-full h-12 flex items-center justify-center text-center px-4 rounded-full text-sm font-bold bg-deep-green text-white shadow hover:bg-brand-green active:scale-98 transition-all">
            Hear it work (Audio Demos)
          </a>
          <a href={`mailto:${site.supportEmail}?subject=Contact%20Technical%20Team`} class="w-full h-12 flex items-center justify-center text-center px-4 rounded-full text-sm font-bold border border-sky-blue text-ink-deep bg-paper hover:bg-light-blue active:scale-98 transition-all">
            Contact Technical Team
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content Container with Nav clearance & mobile safe bottom clearance -->
    <main class="pt-16 pb-20 sm:pb-0 min-h-screen">
      <slot />
    </main>

    <!-- Sticky Mobile Bottom Bar (Phones Only - Designed with Safe-Area Clearance & Centered Alignment) -->
    <div class="sm:hidden fixed bottom-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-md border-t border-sky-blue px-4 pt-3 pb-[max(1.25rem,env(safe-area-inset-bottom,1.25rem))] flex items-center justify-center gap-3 shadow-[0_-4px_16px_rgba(0,0,0,0.08)]">
      <a href="/demo" class="flex-1 h-12 flex items-center justify-center text-center px-3 rounded-full text-xs font-bold bg-deep-green text-white shadow-sm hover:bg-brand-green active:scale-95 transition-all">
        Hear it work
      </a>
      <a href={site.bookingUrl} target="_blank" rel="noopener noreferrer" class="flex-1 h-12 flex items-center justify-center text-center px-3 rounded-full text-xs font-bold border border-sky-blue text-ink-deep bg-light-blue/50 hover:bg-light-blue active:scale-95 transition-all">
        Book a 15 min call
      </a>
    </div>

    <!-- Multi-Device Adaptive Deep Green Architectural Footer (#0E4D3A) -->
    <footer class="bg-deep-green text-white relative noise-overlay pt-14 sm:pt-20 pb-28 sm:pb-10 overflow-hidden border-t border-brand-green/30">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        
        <!-- Main Footer Content Grid: Balanced, Tight Spacing Without Giant Voids -->
        <div class="flex flex-col lg:flex-row lg:justify-between gap-10 lg:gap-12 pb-10 sm:pb-12 border-b border-white/10">
          
            <!-- Col 1: Brand & Direct Contact -->
          <div class="w-full lg:max-w-sm shrink-0">
            <div class="mb-5">
              <a href="/" class="inline-block px-3.5 py-2 rounded-2xl bg-white/95 border border-white/25 shadow-md hover:bg-white transition-all" aria-label="Talkera Desk">
                <img
                  src="/logo.png"
                  alt="Talkera Desk"
                  class="h-10 sm:h-11 md:h-12 w-auto object-contain"
                  width="190"
                  height="42"
                  loading="lazy"
                />
              </a>
            </div>

            <div class="mb-5 max-w-sm">
              <h3 class="font-heading text-lg sm:text-xl font-extrabold tracking-tight text-lime-accent">Turning missed calls into business</h3>
              <p class="mt-2 text-sm leading-relaxed text-gray-300">
                Your in-house phone team for home service and restoration businesses. We build your voice agent, connect your calendar or CRM, answer calls 24/7, review calls, and text your crew and callers.
              </p>
            </div>

            <!-- Direct Contact Tap Targets (Optimized for Mobile & Desktop) -->
            <div class="space-y-2 text-xs font-sans">
              <div class="flex flex-wrap items-center gap-1.5 sm:gap-2">
                <span class="text-lime-accent font-semibold">Email:</span>
                <a href={`mailto:${site.supportEmail}`} class="text-gray-200 hover:text-white underline break-all">{site.supportEmail}</a>
              </div>
              <div class="flex flex-wrap items-center gap-1.5 sm:gap-2">
                <span class="text-lime-accent font-semibold">WhatsApp:</span>
                <a href={`https://wa.me/${site.whatsapp.replace(/[^0-9]/g, '')}`} class="text-gray-200 hover:text-white underline">{site.whatsappFormatted}</a>
              </div>
            </div>
          </div>

          <!-- Navigation Columns: Grouped with Natural, Tightly-Controlled Gaps (No 200px empty deserts) -->
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-8 sm:gap-10 lg:gap-12 flex-1 lg:max-w-2xl xl:max-w-3xl">
            
            <!-- Col 2: Platform Links -->
            <div>
              <h4 class="font-heading text-xs uppercase tracking-wider text-lime-accent font-bold mb-3 sm:mb-4">Platform</h4>
              <ul class="space-y-2 sm:space-y-2.5 text-xs text-gray-300">
                <li><a href="/how-it-works" class="hover:text-white transition-colors py-0.5 block">How it works</a></li>
                <li><a href="/pricing" class="hover:text-white transition-colors py-0.5 block">Pricing</a></li>
                <li><a href="/compare" class="hover:text-white transition-colors py-0.5 block">Compare</a></li>
                <li><a href="/integrations" class="hover:text-white transition-colors py-0.5 block">Integrations</a></li>
                <li><a href="/demo" class="hover:text-white transition-colors py-0.5 block">Demos</a></li>
                <li><a href="/faq" class="hover:text-white transition-colors py-0.5 block">FAQ</a></li>
                <li><a href="/about" class="hover:text-white transition-colors py-0.5 block">About</a></li>
              </ul>
            </div>

            <!-- Col 3: Industries -->
            <div>
              <h4 class="font-heading text-xs uppercase tracking-wider text-lime-accent font-bold mb-3 sm:mb-4">Industries</h4>
              <ul class="space-y-2 sm:space-y-2.5 text-xs text-gray-300">
                <li><a href="/water-damage-restoration" class="hover:text-white transition-colors py-0.5 block">Water damage restoration</a></li>
                <li><a href="/water-damage-restoration#emergency" class="hover:text-white transition-colors py-0.5 block">Fire & Smoke Remediation</a></li>
                <li><a href="/plumbing-hvac-electrical" class="hover:text-white transition-colors py-0.5 block">Plumbing</a></li>
                <li><a href="/plumbing-hvac-electrical#hvac" class="hover:text-white transition-colors py-0.5 block">Heating & cooling</a></li>
                <li><a href="/plumbing-hvac-electrical#electrical" class="hover:text-white transition-colors py-0.5 block">Electrical work</a></li>
                <li><a href="/guides/how-much-does-a-missed-call-cost-a-restoration-company" class="hover:text-white transition-colors py-0.5 block">Restoration ROI Guide</a></li>
              </ul>
            </div>

            <!-- Col 4: Legal & Compliance Suite (Single Clean Vertical Column, matching Platform & Industries) -->
            <div class="col-span-2 sm:col-span-1">
              <h4 class="font-heading text-xs uppercase tracking-wider text-lime-accent font-bold mb-3 sm:mb-4">Legal & Compliance</h4>
              <ul class="space-y-2 sm:space-y-2.5 text-xs text-gray-300">
                <li><a href="/legal" class="hover:text-white transition-colors font-semibold text-white/95 py-0.5 block">Legal Hub & Identity</a></li>
                <li><a href="/terms" class="hover:text-white transition-colors py-0.5 block">Terms of Service</a></li>
                <li><a href="/privacy" class="hover:text-white transition-colors py-0.5 block">Privacy Policy</a></li>
                <li><a href="/cookies" class="hover:text-white transition-colors py-0.5 block">Cookies Policy</a></li>
                <li><a href="/ai-and-recording" class="hover:text-white transition-colors py-0.5 block">AI & Recording Consent</a></li>
                <li><a href="/dpa" class="hover:text-white transition-colors py-0.5 block">Data Processing (DPA)</a></li>
                <li><a href="/sub-processors" class="hover:text-white transition-colors py-0.5 block">Sub-Processors List</a></li>
                <li><a href="/accessibility" class="hover:text-white transition-colors py-0.5 block">Accessibility Policy</a></li>
                <li><a href="/cancellation" class="hover:text-white transition-colors py-0.5 block">Cancellation & Refunds</a></li>
              </ul>
            </div>

          </div>

        </div>

        <!-- Official Registration & Verification Bar: Dedicated Full-Width Row (Guarantees GSTIN 0 never wraps on any device) -->
        <div class="py-5 border-b border-white/10 flex flex-col md:flex-row items-stretch md:items-center justify-between gap-3 text-xs">
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 w-full md:w-auto">
            
            <!-- Active GSTIN Card: whitespace-nowrap ensures 10FGTPR7427G1Z0 stays completely intact -->
            <div class="px-3.5 py-2.5 rounded-xl bg-white/5 border border-white/10 flex items-center justify-between sm:justify-start gap-3 shadow-sm">
              <div class="flex items-center gap-2 whitespace-nowrap">
                <span class="w-2 h-2 rounded-full bg-emerald-400 shrink-0"></span>
                <span class="text-gray-300 text-xs whitespace-nowrap">Active GSTIN: <strong class="text-white font-sans font-bold whitespace-nowrap tracking-wider tabular">{site.gstin}</strong></span>
              </div>
              <a href={site.gstVerificationUrl} target="_blank" rel="noopener noreferrer" class="text-lime-accent hover:text-white underline text-xs font-semibold whitespace-nowrap shrink-0">
                Verify Portal &rarr;
              </a>
            </div>

            <!-- Udyam Registration Card -->
            <div class="px-3.5 py-2.5 rounded-xl bg-white/5 border border-white/10 flex items-center justify-between sm:justify-start gap-3 shadow-sm">
              <div class="flex items-center gap-2 whitespace-nowrap">
                <span class="w-2 h-2 rounded-full bg-emerald-400 shrink-0"></span>
                <span class="text-gray-300 text-[11px] sm:text-xs whitespace-nowrap">Udyam Reg: <strong class="text-white font-sans font-bold text-[11px] sm:text-xs whitespace-nowrap tracking-wider tabular">{site.udyamNumber}</strong></span>
              </div>
              <a href={site.udyamVerificationUrl} target="_blank" rel="noopener noreferrer" class="text-lime-accent hover:text-white underline text-[10px] sm:text-xs font-semibold whitespace-nowrap shrink-0">
                Verify Portal &rarr;
              </a>
            </div>

          </div>

          <div class="text-gray-400 text-xs text-center md:text-right font-sans">
            DRUVA GROUP &bull; Tax & Legal Compliant
          </div>
        </div>

        <!-- Bottom Line Legal Transparency & Device Adapted Footer Bar -->
        <div class="pt-6 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-gray-400">
          <p class="text-center md:text-left leading-relaxed max-w-2xl break-words">
            Serving the US, UK, Canada, Australia and India.<br />
            <strong class="text-gray-200">Talkera Desk</strong> is a brand of <strong class="text-gray-200">{site.enterpriseName}</strong>, a registered sole proprietorship in India (Udyam: <span class="font-sans text-gray-300 whitespace-nowrap">{site.udyamNumber}</span>, Active GSTIN: <a href={site.gstVerificationUrl} target="_blank" rel="noopener noreferrer" class="font-sans text-gray-300 underline hover:text-white whitespace-nowrap font-bold">{site.gstin}</a>). Operational Base: <span class="text-gray-300">{site.teamLocations}</span>.
          </p>
          <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-6 pt-2 md:pt-0">
