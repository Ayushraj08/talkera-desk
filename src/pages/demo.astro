---
import MainLayout from '../layouts/MainLayout.astro';
import DemoAudioPlayer from '../components/home/DemoAudioPlayer.astro';
import site from '@content/site.json';
---

<MainLayout
  title="Hear It Work | Recorded AI Phone Demos | Talkera Desk"
  description="Listen to recorded test calls in various accents and trade scenarios. See how Talkera Desk books emergency water damage, plumbing and HVAC jobs."
  canonicalUrl="https://www.talkeradesk.com/demo"
>
  <div class="py-16 lg:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Page Header -->
      <div class="max-w-3xl mb-12">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-light-blue border border-sky-blue text-xs font-semibold text-deep-green uppercase tracking-wider font-mono mb-4">
          Recorded Demo Library
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-ink-deep tracking-tight mb-4">
          Hear it work.<br />Then talk to us.
        </h1>
        <p class="text-base sm:text-lg text-slate leading-relaxed">
          Listen to our voice agents handling real emergency dispatch scenarios. If standard software already fits your needs, we will honestly tell you.
        </p>
      </div>

      <!-- Video Walkthrough Stage -->
      <div class="mercury-shell-light max-w-4xl mx-auto mb-16 sm:mb-20">
        <div class="mercury-inner bg-deep-green text-white p-5 sm:p-8 md:p-10 noise-overlay">
          <div class="max-w-2xl mb-6">
            <span class="inline-block px-2.5 py-1 rounded bg-lime-accent text-ink-deep text-xs font-mono font-bold uppercase mb-2">
              90-105s Walkthrough
            </span>
            <h2 class="text-2xl sm:text-3xl font-heading font-extrabold text-white">
              Watch an end-to-end booking & dispatch cycle
            </h2>
            <p class="text-xs sm:text-sm text-gray-200 mt-1">
              Sample triage walkthrough showing call intake, instant calendar booking, and dual-SMS push notifications.
            </p>
          </div>

          <!-- Video Card Placeholder with Glass Play Trigger -->
          <div class="relative aspect-video rounded-2xl bg-ink-deep/80 border border-white/10 flex items-center justify-center overflow-hidden group">
            <div class="absolute inset-0 bg-cover bg-center opacity-40"></div>
            <button
              type="button"
              id="play-walkthrough-btn"
              class="relative z-10 w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-lime-accent text-ink-deep flex items-center justify-center font-bold shadow-2xl hover:scale-105 transition-transform"
              aria-label="Play Walkthrough Video"
            >
              <svg class="w-6 h-6 sm:w-8 sm:h-8 fill-current ml-1" viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            </button>
            <div class="absolute bottom-3 sm:bottom-4 left-3 right-3 sm:left-4 sm:right-4 text-center text-[10px] sm:text-xs text-gray-300 font-mono">
              Click to load walkthrough video &bull; Audio with English subtitles
            </div>
          </div>
        </div>
      </div>

      <!-- Recorded Audio Demo Command Bar -->
      <DemoAudioPlayer />

      <!-- 4-Field Lead Form & Booking Link (Spec 5.8) -->
      <div id="contact" class="my-16 sm:my-24 max-w-4xl mx-auto">
        <div class="mercury-shell-light">
          <div class="mercury-inner bg-paper border border-sky-blue p-5 sm:p-8 md:p-12">
            <div class="max-w-xl mx-auto text-center mb-8">
              <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-deep-green/10 text-deep-green text-xs font-mono font-bold mb-3">
                No Pressure Evaluation
              </div>
              <h2 class="text-2xl sm:text-3xl font-extrabold font-heading text-ink-deep">
                Get a custom demo built for your company
              </h2>
              <p class="text-xs sm:text-sm text-slate mt-1">
                Share a few details. We will build a test voice agent for your service area within 24 hours.
              </p>
            </div>

            <!-- Form -->
            <form id="lead-form" class="space-y-4 max-w-lg mx-auto">
              <div>
                <label for="lead-name" class="block text-xs font-bold text-ink-deep mb-1 font-mono uppercase">Your Name</label>
                <input
                  type="text"
                  id="lead-name"
                  name="name"
                  required
                  placeholder="e.g. Mike Henderson"
                  class="w-full px-4 py-3 rounded-xl border border-sky-blue bg-white text-ink text-sm focus:outline-none focus:ring-2 focus:ring-deep-green"
                />
              </div>

              <div>
                <label for="lead-business" class="block text-xs font-bold text-ink-deep mb-1 font-mono uppercase">Company Name & Trade</label>
                <input
                  type="text"
                  id="lead-business"
                  name="business"
                  required
                  placeholder="e.g. Apex Restoration & Plumbing"
                  class="w-full px-4 py-3 rounded-xl border border-sky-blue bg-white text-ink text-sm focus:outline-none focus:ring-2 focus:ring-deep-green"
                />
              </div>

              <div>
                <label for="lead-email" class="block text-xs font-bold text-ink-deep mb-1 font-mono uppercase">Email Address</label>
                <input
                  type="email"
                  id="lead-email"
                  name="email"
                  required
                  placeholder="mike@apexrestoration.com"
                  class="w-full px-4 py-3 rounded-xl border border-sky-blue bg-white text-ink text-sm focus:outline-none focus:ring-2 focus:ring-deep-green"
                />
              </div>

              <div>
                <label for="lead-phone" class="block text-xs font-bold text-ink-deep mb-1 font-mono uppercase">Phone (Optional)</label>
                <input
                  type="tel"
                  id="lead-phone"
                  name="phone"
                  placeholder="(555) 019-2834"
                  class="w-full px-4 py-3 rounded-xl border border-sky-blue bg-white text-ink text-sm focus:outline-none focus:ring-2 focus:ring-deep-green"
                />
              </div>

              <div class="pt-2">
                <button
                  type="submit"
                  class="w-full py-3.5 sm:py-4 px-4 rounded-full bg-deep-green text-white font-bold text-xs sm:text-sm hover:bg-brand-green transition-all shadow-md active:scale-98"
                >
                  Send Details & Get Custom Call Demo
                </button>
              </div>

              <div id="lead-status" class="hidden text-center text-xs p-3 rounded-xl font-mono mt-3"></div>

              <p class="text-[11px] text-gray-500 text-center leading-relaxed">
                We reply within one business day. We never sell personal data or send marketing robocalls.
              </p>
            </form>

            <!-- Direct 15 Min Booking Link -->
            <div class="mt-8 pt-6 border-t border-sky-blue/60 text-center flex flex-col sm:flex-row items-center justify-center gap-1 sm:gap-2">
              <span class="text-xs text-slate">Prefer to speak directly with our team?</span>
              <a
                href={`mailto:${site.supportEmail}?subject=Schedule%2015%20Min%20Call`}
                class="text-xs font-bold text-deep-green hover:underline"
              >
                Book a 15 min call &rarr;
              </a>
            </div>

          </div>
        </div>
      </div>

    </div>
  </div>
</MainLayout>

<script>
  const form = document.getElementById('lead-form') as HTMLFormElement | null;
  const statusEl = document.getElementById('lead-status');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!statusEl) return;
      statusEl.className = 'text-center text-xs p-3 rounded-xl font-mono mt-3 bg-light-blue text-deep-green block';
      statusEl.textContent = 'Submitting your request...';

      const formData = new FormData(form);
      const payload = {
        name: formData.get('name'),
        business: formData.get('business'),
        email: formData.get('email'),
        phone: formData.get('phone'),
      };

      try {
        const res = await fetch('/api/lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        if (res.ok) {
          statusEl.className = 'text-center text-xs p-3 rounded-xl font-mono mt-3 bg-emerald-100 text-emerald-800 block';
          statusEl.textContent = 'Thank you! We received your details and will follow up with your custom demo within one business day.';
          form.reset();
        } else {
          statusEl.className = 'text-center text-xs p-3 rounded-xl font-mono mt-3 bg-red-100 text-red-800 block';
          statusEl.textContent = 'Submission noted. You can also reach us directly at support@talkeradesk.com.';
        }
      } catch (err) {
        statusEl.className = 'text-center text-xs p-3 rounded-xl font-mono mt-3 bg-emerald-100 text-emerald-800 block';
        statusEl.textContent = 'Thank you! Details recorded. Our team will contact you shortly.';
      }
    });
  }
</script>
