---
import MainLayout from '../layouts/MainLayout.astro';
import CallMatrix from '../components/home/CallMatrix.astro';
import FinalCta from '../components/home/FinalCta.astro';
---

<MainLayout
  title="How Talkera Desk works | Setup, calls and support"
  description="We set up your phone assistant, connect your calendar, answer calls and review results. Ready in up to 3 days."
  canonicalUrl="https://www.talkeradesk.com/how-it-works"
>
  <!-- Hero & 10-Step Lifecycle of One Call -->
  <section class="pt-16 pb-12 lg:pt-24 lg:pb-16 bg-white border-b border-sky-blue/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Page Hero Header -->
      <div class="max-w-3xl mb-16">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-ink-deep tracking-tight mb-4 font-heading">
          We set it up and keep it running.
        </h1>
        <p class="text-base sm:text-lg text-slate leading-relaxed">
          We set up the phone assistant, connect your calendar and review its calls. You focus on the work; Talkera handles the phone.
        </p>
      </div>

      <!-- Section: The 10-Step Lifecycle of One Call -->
      <div class="my-12 lg:my-16">
        <div class="max-w-2xl mb-10">
          <h2 class="text-2xl sm:text-3xl font-extrabold font-heading text-ink-deep">
            What happens when a customer calls
          </h2>
          <p class="text-xs sm:text-sm text-slate mt-1">
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
          <!-- Step 1 -->
          <div class="p-5 rounded-2xl bg-paper border border-sky-blue flex flex-col justify-between">
            <div>
              <span class="font-sans text-xs font-bold text-deep-green">01</span>
              <h3 class="font-heading font-bold text-sm text-ink-deep mt-2 mb-1">The phone rings</h3>
              <p class="text-xs text-slate">Talkera answers day or night.</p>
            </div>
          </div>

          <!-- Step 2 -->
          <div class="p-5 rounded-2xl bg-paper border border-sky-blue flex flex-col justify-between">
            <div>
              <span class="font-sans text-xs font-bold text-deep-green">02</span>
              <h3 class="font-heading font-bold text-sm text-ink-deep mt-2 mb-1">Caller gets a notice</h3>
              <p class="text-xs text-slate">Talkera says it is AI and if the call is recorded.</p>
            </div>
          </div>

          <!-- Step 3 -->
          <div class="p-5 rounded-2xl bg-paper border border-sky-blue flex flex-col justify-between">
            <div>
              <span class="font-sans text-xs font-bold text-deep-green">03</span>
              <h3 class="font-heading font-bold text-sm text-ink-deep mt-2 mb-1">It asks what happened</h3>
              <p class="text-xs text-slate">It gets the address, problem and urgency.</p>
            </div>
          </div>

          <!-- Step 4 -->
          <div class="p-5 rounded-2xl bg-paper border border-sky-blue flex flex-col justify-between">
            <div>
              <span class="font-sans text-xs font-bold text-deep-green">04</span>
              <h3 class="font-heading font-bold text-sm text-ink-deep mt-2 mb-1">A visit is booked</h3>
              <p class="text-xs text-slate">It books a time in your calendar or job software.</p>
            </div>
          </div>

          <!-- Step 5 -->
          <div class="p-5 rounded-2xl bg-paper border border-sky-blue flex flex-col justify-between">
            <div>
              <span class="font-sans text-xs font-bold text-deep-green">05</span>
              <h3 class="font-heading font-bold text-sm text-ink-deep mt-2 mb-1">Caller gets a text</h3>
              <p class="text-xs text-slate">The text confirms the visit time and technician.</p>
            </div>
          </div>

          <!-- Step 6 -->
          <div class="p-5 rounded-2xl bg-paper border border-sky-blue flex flex-col justify-between">
            <div>
              <span class="font-sans text-xs font-bold text-deep-green">06</span>
              <h3 class="font-heading font-bold text-sm text-ink-deep mt-2 mb-1">Your team gets the details</h3>
              <p class="text-xs text-slate">The assigned worker gets the job notes by text.</p>
            </div>
          </div>

          <!-- Step 7 -->
          <div class="p-5 rounded-2xl bg-paper border border-sky-blue flex flex-col justify-between">
            <div>
              <span class="font-sans text-xs font-bold text-deep-green">07</span>
              <h3 class="font-heading font-bold text-sm text-ink-deep mt-2 mb-1">Visit is confirmed</h3>
              <p class="text-xs text-slate">Talkera checks by text 2 to 3 hours before the visit.</p>
            </div>
          </div>

          <!-- Step 8 -->
          <div class="p-5 rounded-2xl bg-paper border border-sky-blue flex flex-col justify-between">
            <div>
              <span class="font-sans text-xs font-bold text-deep-green">08</span>
              <h3 class="font-heading font-bold text-sm text-ink-deep mt-2 mb-1">Caller can change the time</h3>
              <p class="text-xs text-slate">They can text or call to reschedule.</p>
            </div>
          </div>

          <!-- Step 9 -->
          <div class="p-5 rounded-2xl bg-paper border border-sky-blue flex flex-col justify-between">
            <div>
              <span class="font-sans text-xs font-bold text-deep-green">09</span>
              <h3 class="font-heading font-bold text-sm text-ink-deep mt-2 mb-1">Review request is sent</h3>
              <p class="text-xs text-slate">After the job, Talkera sends a thank-you and review link.</p>
            </div>
          </div>

          <!-- Step 10 -->
          <div class="p-5 rounded-2xl bg-deep-green text-white flex flex-col justify-between">
            <div>
              <span class="font-sans text-xs font-bold text-lime-accent">10</span>
              <h3 class="font-heading font-bold text-sm text-white mt-2 mb-1">Urgent calls reach your team</h3>
              <p class="text-xs text-gray-200">Talkera calls your on-call worker if someone may be in danger.</p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Interactive Call Matrix: What happens on every kind of call -->
  <CallMatrix />

  <!-- Operations, Onboarding Timeline & Policies -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Section: We Handle vs You Handle Grid -->
      <div class="mb-20">
        <div class="max-w-2xl mb-8">
          <h2 class="text-2xl sm:text-3xl font-extrabold font-heading text-ink-deep">
            Who does what
          </h2>
          <p class="text-xs sm:text-sm text-slate mt-1">
          </p>
        </div>

        <div class="border border-sky-blue rounded-2xl overflow-hidden bg-white shadow-tactile">
          <table class="min-w-full divide-y divide-sky-blue/60 text-xs">
            <thead class="bg-paper text-ink-deep font-sans font-bold">
              <tr>
                <th class="py-4 px-6 text-left w-1/2">Talkera handles</th>
                <th class="py-4 px-6 text-left w-1/2">You handle</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 text-slate">
              <tr>
                <td class="py-4 px-6 font-semibold text-deep-green">Phone number and text setup</td>
                <td class="py-4 px-6">Your services, hours and call rules</td>
              </tr>
              <tr>
                <td class="py-4 px-6 font-semibold text-deep-green">Set up and test the assistant</td>
                <td class="py-4 px-6">Listen to test calls and approve them</td>
              </tr>
              <tr>
                <td class="py-4 px-6 font-semibold text-deep-green">Connect your calendar or job software</td>
                <td class="py-4 px-6">Give us access to those tools</td>
              </tr>
              <tr>
                <td class="py-4 px-6 font-semibold text-deep-green">Run it, check calls and fix problems</td>
                <td class="py-4 px-6">Take calls Talkera sends to you</td>
              </tr>
              <tr>
                <td class="py-4 px-6 font-semibold text-deep-green">Review calls and send reports</td>
                <td class="py-4 px-6">Tell us when your services change</td>
              </tr>
              <tr>
                <td class="py-4 px-6 font-semibold text-deep-green">Talkera service and phone fees in your plan</td>
                <td class="py-4 px-6">Fees for your own software and phone plan</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Up to 3 Days to Live Breakdown -->
      <div class="my-20">
        <div class="max-w-2xl mb-8">
          <h2 class="text-2xl sm:text-3xl font-extrabold font-heading text-ink-deep">
            Up to 3 days to go live
          </h2>
          <p class="text-xs sm:text-sm text-slate mt-1">
            We need your answers within 2 to 3 business hours to meet this timeline.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="p-6 rounded-2xl bg-paper border border-sky-blue">
            <span class="text-xs font-sans font-bold text-brand-green uppercase">Day 1</span>
            <h3 class="font-heading font-bold text-lg text-ink-deep my-2">We set it up</h3>
            <p class="text-xs text-slate leading-relaxed">
              We use your website and the details you give us to set up your assistant.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-paper border border-sky-blue">
            <span class="text-xs font-sans font-bold text-brand-green uppercase">Day 2</span>
            <h3 class="font-heading font-bold text-lg text-ink-deep my-2">We adjust the call rules</h3>
            <p class="text-xs text-slate leading-relaxed">
              We check how it speaks, what areas you serve and when it should alert your team.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-deep-green text-white">
            <span class="text-xs font-sans font-bold text-lime-accent uppercase">Day 3</span>
            <h3 class="font-heading font-bold text-lg text-white my-2">We test and go live</h3>
            <p class="text-xs text-gray-200 leading-relaxed">
              We connect your calendar, test calls and texts, then turn on call answering.
            </p>
          </div>
        </div>
      </div>

      <!-- Data Ownership & Fixes -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 my-20">
        <div class="p-8 rounded-2xl bg-paper border border-sky-blue">
          <h3 class="font-heading font-bold text-xl text-ink-deep mb-3">Your number and recordings belong to you</h3>
          <p class="text-xs sm:text-sm text-slate leading-relaxed mb-4">
            You own your number, recordings and transcripts. We keep recordings for 15 to 60 days based on your plan, then delete them. Ask us for a copy; we send it within 7 days.
          </p>
          <div class="text-xs font-sans text-brand-green font-semibold">We do not train AI on your call recordings.</div>
        </div>

        <div class="p-8 rounded-2xl bg-paper border border-sky-blue">
          <h3 class="font-heading font-bold text-xl text-ink-deep mb-3">If we take too long to fix a problem</h3>
          <p class="text-xs sm:text-sm text-slate leading-relaxed mb-4">
            We start work as soon as you report a problem and aim to fix it within 72 hours. If a problem on our side takes more than 24 hours, we add a credit for each extra day.
          </p>
        </div>
      </div>

    </div>
  </section>

  <FinalCta />
</MainLayout>
