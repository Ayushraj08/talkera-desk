---
import MainLayout from '../layouts/MainLayout.astro';
import CallMatrix from '../components/home/CallMatrix.astro';
import FinalCta from '../components/home/FinalCta.astro';
---

<MainLayout
  title="How Talkera Desk Works | We Build It, Run It and Fix It"
  description="How our in-house AI phone team answers calls 24/7, books jobs into your calendar, and keeps your crew and callers updated by text. Live in up to 3 days."
  canonicalUrl="https://www.talkeradesk.com/how-it-works"
>
  <!-- Hero & 10-Step Lifecycle of One Call -->
  <section class="pt-16 pb-12 lg:pt-24 lg:pb-16 bg-white border-b border-sky-blue/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Page Hero Header -->
      <div class="max-w-3xl mb-16">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-light-blue border border-sky-blue text-xs font-semibold text-deep-green uppercase tracking-wider font-mono mb-4">
          Complete Operational Blueprint
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-ink-deep tracking-tight mb-4 font-heading">
          We build it, run it and fix it.<br />You get on with the job.
        </h1>
        <p class="text-base sm:text-lg text-slate leading-relaxed">
          Talkera Desk is not a self-serve software tool you have to configure or a vendor you chase. We build your voice agent, connect your calendar or CRM, run it 24/7, review calls, and keep your callers and technicians updated by text.
        </p>
      </div>

      <!-- Section: The 10-Step Lifecycle of One Call -->
      <div class="my-12 lg:my-16">
        <div class="max-w-2xl mb-10">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-deep-green/10 text-deep-green text-xs font-mono font-bold uppercase tracking-wider mb-2">
            Step-by-Step Flow
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold font-heading text-ink-deep">
            What happens on a single customer call
          </h2>
          <p class="text-xs sm:text-sm text-slate mt-1">
            From the first ring to the 5-star review, every step is automated and logged into your systems.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
          <!-- Step 1 -->
          <div class="p-5 rounded-2xl bg-paper border border-sky-blue flex flex-col justify-between">
            <div>
              <span class="font-mono text-xs font-bold text-deep-green">01 / ARRIVAL</span>
              <h3 class="font-heading font-bold text-sm text-ink-deep mt-2 mb-1">Call Arrives 24/7</h3>
              <p class="text-xs text-slate">Answers on the first or second ring with dedicated channel capacity.</p>
            </div>
            <div class="pt-3 border-t border-sky-blue/50 text-[11px] font-mono text-gray-500 mt-4">Zero Hold Time</div>
          </div>

          <!-- Step 2 -->
          <div class="p-5 rounded-2xl bg-paper border border-sky-blue flex flex-col justify-between">
            <div>
              <span class="font-mono text-xs font-bold text-deep-green">02 / DISCLOSURE</span>
              <h3 class="font-heading font-bold text-sm text-ink-deep mt-2 mb-1">AI & Recording Notice</h3>
              <p class="text-xs text-slate">Discloses it is an AI assistant and announces recording for dispatch notes.</p>
            </div>
            <div class="pt-3 border-t border-sky-blue/50 text-[11px] font-mono text-gray-500 mt-4">Full Compliance</div>
          </div>

          <!-- Step 3 -->
          <div class="p-5 rounded-2xl bg-paper border border-sky-blue flex flex-col justify-between">
            <div>
              <span class="font-mono text-xs font-bold text-deep-green">03 / TRIAGE</span>
              <h3 class="font-heading font-bold text-sm text-ink-deep mt-2 mb-1">Key Intake Triage</h3>
              <p class="text-xs text-slate">Captures address, damage type, physical danger, urgency, and contact info.</p>
            </div>
            <div class="pt-3 border-t border-sky-blue/50 text-[11px] font-mono text-gray-500 mt-4">Your Custom Scope</div>
          </div>

          <!-- Step 4 -->
          <div class="p-5 rounded-2xl bg-paper border border-sky-blue flex flex-col justify-between">
            <div>
              <span class="font-mono text-xs font-bold text-deep-green">04 / BOOKING</span>
              <h3 class="font-heading font-bold text-sm text-ink-deep mt-2 mb-1">Direct Calendar Hold</h3>
              <p class="text-xs text-slate">Locks the appointment or holds an emergency slot directly in your CRM.</p>
            </div>
            <div class="pt-3 border-t border-sky-blue/50 text-[11px] font-mono text-gray-500 mt-4">Two-Way Sync</div>
          </div>

          <!-- Step 5 -->
          <div class="p-5 rounded-2xl bg-paper border border-sky-blue flex flex-col justify-between">
            <div>
              <span class="font-mono text-xs font-bold text-deep-green">05 / CALLER SMS</span>
              <h3 class="font-heading font-bold text-sm text-ink-deep mt-2 mb-1">Instant Confirmation</h3>
              <p class="text-xs text-slate">Texts the homeowner confirmed arrival window, tech name, and support options.</p>
            </div>
            <div class="pt-3 border-t border-sky-blue/50 text-[11px] font-mono text-gray-500 mt-4">Proof of Consent</div>
          </div>

          <!-- Step 6 -->
          <div class="p-5 rounded-2xl bg-paper border border-sky-blue flex flex-col justify-between">
            <div>
              <span class="font-mono text-xs font-bold text-deep-green">06 / TEAM ALERT</span>
              <h3 class="font-heading font-bold text-sm text-ink-deep mt-2 mb-1">Technician Dispatch</h3>
              <p class="text-xs text-slate">Dispatches who, what, where, when, and audio notes to assigned tech & owner.</p>
            </div>
            <div class="pt-3 border-t border-sky-blue/50 text-[11px] font-mono text-gray-500 mt-4">SMS & Webhook</div>
          </div>

          <!-- Step 7 -->
          <div class="p-5 rounded-2xl bg-paper border border-sky-blue flex flex-col justify-between">
            <div>
              <span class="font-mono text-xs font-bold text-deep-green">07 / PRE-CHECK</span>
              <h3 class="font-heading font-bold text-sm text-ink-deep mt-2 mb-1">3-Hr Arrival Verification</h3>
              <p class="text-xs text-slate">Texts the caller 2-3 hours prior asking to confirm. Prevents wasted truck rolls.</p>
            </div>
            <div class="pt-3 border-t border-sky-blue/50 text-[11px] font-mono text-gray-500 mt-4">Reduces No-Shows</div>
          </div>

          <!-- Step 8 -->
          <div class="p-5 rounded-2xl bg-paper border border-sky-blue flex flex-col justify-between">
            <div>
              <span class="font-mono text-xs font-bold text-deep-green">08 / RESCHEDULING</span>
              <h3 class="font-heading font-bold text-sm text-ink-deep mt-2 mb-1">Self-Serve Adjustments</h3>
              <p class="text-xs text-slate">Homeowner can text or call to shift windows without disturbing your crew.</p>
            </div>
            <div class="pt-3 border-t border-sky-blue/50 text-[11px] font-mono text-gray-500 mt-4">Real-Time Sync</div>
          </div>

          <!-- Step 9 -->
          <div class="p-5 rounded-2xl bg-paper border border-sky-blue flex flex-col justify-between">
            <div>
              <span class="font-mono text-xs font-bold text-deep-green">09 / REVIEW</span>
              <h3 class="font-heading font-bold text-sm text-ink-deep mt-2 mb-1">Post-Job Review SMS</h3>
              <p class="text-xs text-slate">Dispatches thank you message and review link once the technician completes work.</p>
            </div>
            <div class="pt-3 border-t border-sky-blue/50 text-[11px] font-mono text-gray-500 mt-4">5-Star Capture</div>
          </div>

          <!-- Step 10 -->
          <div class="p-5 rounded-2xl bg-deep-green text-white flex flex-col justify-between">
            <div>
              <span class="font-mono text-xs font-bold text-lime-accent">10 / ESCALATION</span>
              <h3 class="font-heading font-bold text-sm text-white mt-2 mb-1">Emergency Hand-Off</h3>
              <p class="text-xs text-gray-200">Life-safety alerts immediately dial on-call phones and bridge calls live.</p>
            </div>
            <div class="pt-3 border-t border-white/20 text-[11px] font-mono text-lime-accent mt-4">Safe Escalations</div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Interactive Call Matrix: What happens on every kind of call -->
  <CallMatrix />

  <!-- Operations, Onboarding Timeline & Policies -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Section: We Handle vs You Handle Grid -->
      <div class="mb-20">
        <div class="max-w-2xl mb-8">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-light-blue border border-sky-blue text-xs font-mono font-bold text-deep-green uppercase tracking-wider mb-2">
            Clear Division of Work
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold font-heading text-ink-deep">
            We handle vs You handle
          </h2>
          <p class="text-xs sm:text-sm text-slate mt-1">
            We are your in-house technical department. You don't configure telephone software.
          </p>
        </div>

        <div class="border border-sky-blue rounded-2xl overflow-hidden bg-white shadow-tactile">
          <table class="min-w-full divide-y divide-sky-blue/60 text-xs">
            <thead class="bg-paper text-ink-deep font-heading font-bold">
              <tr>
                <th class="py-4 px-6 text-left w-1/2">What Talkera Desk Handles</th>
                <th class="py-4 px-6 text-left w-1/2">What You Handle</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 text-slate">
              <tr>
                <td class="py-4 px-6 font-semibold text-deep-green">Phone number, text registration & carrier setup</td>
                <td class="py-4 px-6">Telling us your services, areas, hours and emergency rules</td>
              </tr>
              <tr>
                <td class="py-4 px-6 font-semibold text-deep-green">Building, testing and launching the agent</td>
                <td class="py-4 px-6">Listening to the test calls and giving your approval</td>
              </tr>
              <tr>
                <td class="py-4 px-6 font-semibold text-deep-green">Connecting to your calendar or CRM</td>
                <td class="py-4 px-6">Giving us access to the tools we connect to</td>
              </tr>
              <tr>
                <td class="py-4 px-6 font-semibold text-deep-green">Running it, monitoring it, and fixing mistakes</td>
                <td class="py-4 px-6">Answering the escalated calls it passes to you</td>
              </tr>
              <tr>
                <td class="py-4 px-6 font-semibold text-deep-green">Call reviews and regular reports (frequency by plan)</td>
                <td class="py-4 px-6">Telling us when your service list or business changes</td>
              </tr>
              <tr>
                <td class="py-4 px-6 font-semibold text-deep-green">Platform costs and carrier fees inside your plan</td>
                <td class="py-4 px-6">Your own software and phone carrier fees</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Up to 3 Days to Live Breakdown -->
      <div class="my-20">
        <div class="max-w-2xl mb-8">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-light-blue border border-sky-blue text-xs font-mono font-bold text-deep-green uppercase tracking-wider mb-2">
            Onboarding Timeline
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold font-heading text-ink-deep">
            Up to 3 days to go live
          </h2>
          <p class="text-xs sm:text-sm text-slate mt-1">
            Turnaround depends on prompt feedback. We ask you to answer questions within 2 to 3 hours during your business day.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="p-6 rounded-2xl bg-paper border border-sky-blue">
            <span class="text-xs font-mono font-bold text-brand-green uppercase">Day 1</span>
            <h3 class="font-heading font-bold text-lg text-ink-deep my-2">Asset Ingestion & Initial Build</h3>
            <p class="text-xs text-slate leading-relaxed">
              We pull what is public about your business (website and official social pages), add what you tell us in your onboarding questionnaire, and start building the same day.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-paper border border-sky-blue">
            <span class="text-xs font-mono font-bold text-brand-green uppercase">Day 2</span>
            <h3 class="font-heading font-bold text-lg text-ink-deep my-2">Refinement & Tone Calibration</h3>
            <p class="text-xs text-slate leading-relaxed">
              We dial in phrasing, natural conversational pauses, service area verification, emergency routing rules, and trade-specific terminology.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-deep-green text-white">
            <span class="text-xs font-mono font-bold text-lime-accent uppercase">Day 3</span>
            <h3 class="font-heading font-bold text-lg text-white my-2">Tool Sync, Testing & Live</h3>
            <p class="text-xs text-gray-200 leading-relaxed">
              We connect your calendar or CRM, run live simulated test calls with your team, verify text dispatch triggers, and switch your line to live answering.
            </p>
          </div>
        </div>
      </div>

      <!-- Data Ownership & Fixes -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 my-20">
        <div class="p-8 rounded-2xl bg-paper border border-sky-blue">
          <h3 class="font-heading font-bold text-xl text-ink-deep mb-3">Your Data: Fully Yours</h3>
          <p class="text-xs sm:text-sm text-slate leading-relaxed mb-4">
            You own your business phone number, your call recordings, and your customer transcripts. Audio and transcripts are retained for 15 to 60 days depending on your plan, then automatically deleted for privacy. We provide a full export within 7 days upon request.
          </p>
          <div class="text-xs font-mono text-brand-green font-semibold">Zero Model Training On Your Call Audio</div>
        </div>

        <div class="p-8 rounded-2xl bg-paper border border-sky-blue">
          <h3 class="font-heading font-bold text-xl text-ink-deep mb-3">The 72-Hour Fix Credit Policy</h3>
          <p class="text-xs sm:text-sm text-slate leading-relaxed mb-4">
            When you report a problem, our engineering team begins diagnosing at once and fixes it as soon as possible, up to 72 hours max. If the fault is on our side and takes more than 24 hours, each additional day is credited directly to your plan.
          </p>
          <div class="text-xs font-mono text-brand-green font-semibold">Credited For Delays Beyond 24 Hours</div>
        </div>
      </div>

    </div>
  </section>

  <FinalCta />
</MainLayout>
