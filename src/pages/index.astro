---
import MainLayout from '../layouts/MainLayout.astro';
import HeroStage from '../components/home/HeroStage.astro';
import StatPillars from '../components/home/StatPillars.astro';
import CallMatrix from '../components/home/CallMatrix.astro';
import DualPhoneStage from '../components/home/DualPhoneStage.astro';
import DemoAudioPlayer from '../components/home/DemoAudioPlayer.astro';
import BuiltForYou from '../components/home/BuiltForYou.astro';
import TimelineThreeDays from '../components/home/TimelineThreeDays.astro';
import ToolsMarquee from '../components/home/ToolsMarquee.astro';
import ComparePreview from '../components/home/ComparePreview.astro';
import PricingGlance from '../components/home/PricingGlance.astro';
import WhoItsFor from '../components/home/WhoItsFor.astro';
import FounderTransparency from '../components/home/FounderTransparency.astro';
import FaqSection from '../components/home/FaqSection.astro';
import FinalCta from '../components/home/FinalCta.astro';
---

<MainLayout
  title="Talkera Desk: AI Call Answering That Books Jobs | No Contract"
  description="AI phone team for home service & restoration businesses. Answers calls 24/7, books jobs, and keeps your caller and crew updated by text. Pay for usage. No contract."
>
  <!-- Section 1 & 2: Hero Stage + Overlapping Trust Panel -->
  <HeroStage />

  <!-- Section 3: Stat Pillars + Missed-Call Revenue Calculator -->
  <StatPillars />

  <!-- Section 4: Runway-Style Interactive Call Matrix -->
  <CallMatrix />

  <!-- Section 5: Mobbin-Style Dual iPhone Hardware Stage -->
  <DualPhoneStage />

  <!-- Section 6: Lovart-Style Demo Audio Player -->
  <DemoAudioPlayer />

  <!-- Section 7: Built For How You Work -->
  <BuiltForYou />

  <!-- Section 8: Up to 3 Days to Live Timeline -->
  <TimelineThreeDays />

  <!-- Section 9: Dual-Row CSS Tools Marquee -->
  <ToolsMarquee />

  <!-- Section 10: How We Compare Preview -->
  <ComparePreview />

  <!-- Section 11: Pricing At A Glance -->
  <PricingGlance />

  <!-- Section 12: Who It Is For -->
  <WhoItsFor />

  <!-- Section 13: Founder & India Transparency -->
  <FounderTransparency />

  <!-- Section 14: Answer-First FAQs -->
  <FaqSection />

  <!-- Section 15: Final CTA Block -->
  <FinalCta />
</MainLayout>
