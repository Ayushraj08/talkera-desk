---
import MainLayout from '../layouts/MainLayout.astro';
import HeroStage from '../components/home/HeroStage.astro';
import DualPhoneStage from '../components/home/DualPhoneStage.astro';
import StatPillars from '../components/home/StatPillars.astro';
import WhoItsFor from '../components/home/WhoItsFor.astro';
import HomeHub from '../components/home/HomeHub.astro';
import FinalCta from '../components/home/FinalCta.astro';
---

<MainLayout
  title="Talkera Desk: AI Call Answering That Books Jobs | No Contract"
  description="AI phone team for home service & restoration businesses. Answers calls 24/7, books jobs, and keeps your caller and crew updated by text. Pay for usage. No contract."
>
  <!-- Section 1: Hero Stage + Overlapping Trust Indicators -->
  <HeroStage />

  <!-- Section 2: Mobbin-Style Dual iPhone Stage (Visual Dispatch & SMS Proof) -->
  <DualPhoneStage />

  <!-- Section 3: Stat Pillars + Interactive Missed-Call Revenue Calculator -->
  <StatPillars />

  <!-- Section 4: Who It Is For (Centered Trade Industry Verticals) -->
  <WhoItsFor />

  <!-- Section 5: Platform Architecture Hub (Compact Centered Exploration of Dedicated Sections) -->
  <HomeHub />

  <!-- Section 6: Final Conversion CTA Block -->
  <FinalCta />
</MainLayout>
