---
import MainLayout from '../layouts/MainLayout.astro';
import FinalCta from '../components/home/FinalCta.astro';
import ToolLogo from '../components/common/ToolLogo.astro';
import tools from '@content/tools.json';

const allTools = [...tools.rowA, ...tools.rowB];
const categories = ["All", ...Array.from(new Set(allTools.map(t => t.category)))];
---

<MainLayout
  title="Software & CRM Integrations | Talkera Desk"
  description="Explore the tools Talkera Desk connects to: ServiceTitan, Jobber, Housecall Pro, Google Calendar, Twilio, and CRM webhooks."
  canonicalUrl="https://www.talkeradesk.com/integrations"
>
  <div class="py-16 lg:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Page Header -->
      <div class="max-w-3xl mb-12">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-ink-deep tracking-tight mb-4">
          Tools we connect to
        </h1>
        <p class="text-base sm:text-lg text-slate leading-relaxed">
          Talkera Desk synchronizes inbound calls directly into your existing dispatch calendars, CRMs, and field management tools.
        </p>
      </div>

      <!-- Category Filter Pills -->
      <div class="flex flex-wrap items-center gap-2 mb-10" id="tool-filters">
        {categories.map((cat, idx) => (
          <button
            type="button"
            data-category={cat}
            class={`tool-filter-btn filter-pill px-4 py-2 rounded-full text-xs font-sans font-semibold border ${
              idx === 0 ? 'is-active' : ''
            }`}
          >
            {cat}
          </button>
        ))}
      </div>

      <!-- Tools Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-16" id="tools-grid">
        {allTools.map((tool) => (
          <div
            data-cat={tool.category}
            class="tool-card p-6 rounded-2xl bg-paper border border-sky-blue shadow-2xs hover:-translate-y-1 transition-all flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between mb-4">
                <div class="w-10 h-10 rounded-xl bg-white border border-sky-blue/80 flex items-center justify-center shadow-xs shrink-0 p-2">
                  <ToolLogo name={tool.name} className="w-6 h-6" />
                </div>
                <span
                  class={`px-2.5 py-0.5 rounded-full text-[10px] font-sans font-bold uppercase tracking-wider ${
                    tool.status === 'live'
                      ? 'bg-emerald-100 text-brand-green border border-emerald-200'
                      : tool.status === 'zapier'
                      ? 'bg-light-blue text-deep-green border border-sky-blue'
                      : 'bg-gray-100 text-slate border border-gray-200'
                  }`}
                >
                  {tool.status === 'live' ? 'Live Integration' : tool.status === 'zapier' ? 'Zapier / Webhook' : 'Built on Request'}
                </span>
              </div>

              <h3 class="font-heading font-bold text-lg text-ink-deep mb-1">
                {tool.name}
              </h3>
              <p class="text-xs text-slate font-sans">
                Category: {tool.category}
              </p>
            </div>

            <div class="pt-4 border-t border-sky-blue/50 mt-6 text-xs text-slate">
              {tool.status === 'live' ? (
                <span class="text-brand-green font-semibold">&check; Two-way instant sync</span>
              ) : tool.status === 'zapier' ? (
                <span>Connects via standard webhooks</span>
              ) : (
                <span>Custom endpoint configured upon onboarding</span>
              )}
            </div>
          </div>
        ))}
      </div>

      <!-- Trademark Disclaimer -->
      <div class="p-6 rounded-2xl bg-paper border border-sky-blue max-w-4xl mx-auto text-xs text-slate text-center">
        <p>
          All product names, logos, and brands mentioned are property of their respective owners. Company, product and service names used in this website are for identification purposes only. Use of these names, logos, and brands does not imply endorsement or affiliation.
        </p>
      </div>

    </div>
  </div>

  <FinalCta />
</MainLayout>

<script>
  const filterBtns = document.querySelectorAll('.tool-filter-btn');
  const cards = document.querySelectorAll('.tool-card');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const selected = btn.getAttribute('data-category');
      
      filterBtns.forEach(b => b.classList.remove('is-active'));
      btn.classList.add('is-active');

      cards.forEach((card) => {
        const cat = card.getAttribute('data-cat');
        if (selected === 'All' || cat === selected) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    });
  });
</script>
