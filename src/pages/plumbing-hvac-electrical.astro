---
import MainLayout from '../layouts/MainLayout.astro';
import FinalCta from '../components/home/FinalCta.astro';
---

<MainLayout
  title="AI Phone Answering for Plumbing, HVAC & Electrical | Talkera Desk"
  description="24/7 AI call answering for trade contractors. Capture after-hours plumbing emergencies, HVAC heatwave diagnostics, and electrical outages into your calendar."
  canonicalUrl="https://www.talkeradesk.com/plumbing-hvac-electrical"
>
  <div class="py-16 lg:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Page Header -->
      <div class="max-w-3xl mb-14">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-ink-deep tracking-tight mb-4">
          AI call answering for plumbing, HVAC and electrical contractors.
        </h1>
        <p class="text-base sm:text-lg text-slate leading-relaxed">
          When your technicians are underneath a house, on a commercial roof, or inside a panel box, they cannot answer incoming leads. Talkera Desk triages the job, locks the appointment in your calendar, and texts your crew.
        </p>
      </div>

      <!-- Trade-Specific Tabs (Plumbing, HVAC, Electrical) -->
      <div class="my-12 sm:my-16">
        <div class="grid grid-cols-3 gap-1.5 p-1.5 bg-paper border border-sky-blue rounded-2xl mb-8 max-w-md w-full">
          <button
            type="button"
            data-trade-tab="plumbing"
            class="trade-nav-btn py-2.5 px-2 text-center rounded-xl text-xs font-bold font-sans transition-all bg-deep-green text-white shadow-xs"
          >
            Plumbing
          </button>
          <button
            type="button"
            data-trade-tab="hvac"
            class="trade-nav-btn py-2.5 px-2 text-center rounded-xl text-xs font-bold font-sans transition-all text-slate hover:text-ink-deep"
          >
            HVAC
          </button>
          <button
            type="button"
            data-trade-tab="electrical"
            class="trade-nav-btn py-2.5 px-2 text-center rounded-xl text-xs font-bold font-sans transition-all text-slate hover:text-ink-deep"
          >
            Electrical
          </button>
        </div>

        <!-- Trade Content Panels -->
        <!-- Plumbing Panel -->
        <div id="panel-plumbing" class="trade-panel space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
            <div class="p-5 sm:p-7 lg:p-8 rounded-panel bg-paper border border-sky-blue">
              <span class="text-xs font-sans font-bold text-deep-green uppercase">Urgent Flow</span>
              <h3 class="font-heading font-bold text-lg sm:text-xl text-ink-deep my-2">Sewer Backups & Freeze Bursts</h3>
              <p class="text-xs sm:text-sm text-slate leading-relaxed mb-4">
                The agent determines if water is actively overflowing, instructs on shutoff locations, holds the earliest emergency slot, and immediately dials on-call plumbers.
              </p>
              <div class="text-xs font-sans text-brand-green font-semibold">Holds Urgent Dispatch Slot</div>
            </div>

            <div class="p-5 sm:p-7 lg:p-8 rounded-panel bg-paper border border-sky-blue">
              <span class="text-xs font-sans font-bold text-slate uppercase">Routine Quote Flow</span>
              <h3 class="font-heading font-bold text-lg sm:text-xl text-ink-deep my-2">Water Heater & Repiping Estimates</h3>
              <p class="text-xs sm:text-sm text-slate leading-relaxed mb-4">
                Collects tank gallon size, fuel type (gas vs electric), accessibility details, and books scheduled estimator visits directly into your CRM.
              </p>
              <div class="text-xs font-sans text-slate font-semibold">Captures Unit Specs & Books Site Visit</div>
            </div>
          </div>
        </div>

        <!-- HVAC Panel -->
        <div id="panel-hvac" class="trade-panel hidden space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
            <div class="p-5 sm:p-7 lg:p-8 rounded-panel bg-paper border border-sky-blue">
              <span class="text-xs font-sans font-bold text-deep-green uppercase">Heatwave Emergency</span>
              <h3 class="font-heading font-bold text-lg sm:text-xl text-ink-deep my-2">Total AC Cooling Failure</h3>
              <p class="text-xs sm:text-sm text-slate leading-relaxed mb-4">
                Identifies elderly occupants or children in high heat, gathers condenser error codes, and books immediate 2-hour diagnostic arrival windows.
              </p>
              <div class="text-xs font-sans text-brand-green font-semibold">Heatwave Surge Protection</div>
            </div>

            <div class="p-5 sm:p-7 lg:p-8 rounded-panel bg-paper border border-sky-blue">
              <span class="text-xs font-sans font-bold text-slate uppercase">Preventative Tune-Ups</span>
              <h3 class="font-heading font-bold text-lg sm:text-xl text-ink-deep my-2">Seasonal Maintenance Booking</h3>
              <p class="text-xs sm:text-sm text-slate leading-relaxed mb-4">
                Answers pre-approved promotional tune-up pricing, locks off-peak schedule slots, and confirms homeowner availability via text.
              </p>
              <div class="text-xs font-sans text-slate font-semibold">Direct Routing to Neighborhood Tech</div>
            </div>
          </div>
        </div>

        <!-- Electrical Panel -->
        <div id="panel-electrical" class="trade-panel hidden space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
            <div class="p-5 sm:p-7 lg:p-8 rounded-panel bg-paper border border-sky-blue">
              <span class="text-xs font-sans font-bold text-deep-green uppercase">Panel Hazards</span>
              <h3 class="font-heading font-bold text-lg sm:text-xl text-ink-deep my-2">Breaker Trips & Burning Odors</h3>
              <p class="text-xs sm:text-sm text-slate leading-relaxed mb-4">
                Warns homeowner to step back from the panel, assesses fire hazards, and triggers an immediate warm transfer to your master electrician.
              </p>
              <div class="text-xs font-sans text-brand-green font-semibold">Safety Warm Handoff First</div>
            </div>

            <div class="p-5 sm:p-7 lg:p-8 rounded-panel bg-paper border border-sky-blue">
              <span class="text-xs font-sans font-bold text-slate uppercase">Commercial & Rewires</span>
              <h3 class="font-heading font-bold text-lg sm:text-xl text-ink-deep my-2">EV Charger & Service Upgrades</h3>
              <p class="text-xs sm:text-sm text-slate leading-relaxed mb-4">
                Collects electrical service amperage (100A vs 200A), vehicle charger model, and schedules an on-site master electrician consultation.
              </p>
              <div class="text-xs font-sans text-slate font-semibold">Detailed Scope Notes to Estimator</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Seasonal Pause Rule ($39/mo Option) -->
      <div class="my-16 sm:my-20 p-5 sm:p-7 lg:p-8 rounded-panel bg-paper border border-sky-blue max-w-4xl mx-auto">
        <div class="flex items-start gap-4">
          <div class="w-10 h-10 rounded-xl bg-deep-green text-lime-accent flex items-center justify-center font-bold shrink-0">
            &bull;
          </div>
          <div>
            <h3 class="font-heading font-bold text-lg text-ink-deep mb-1">
              Seasonal Slow-Season Pause Protection ($39/mo)
            </h3>
            <p class="text-xs sm:text-sm text-slate leading-relaxed">
              In a quiet month, move to Pay As You Go at $0.59 a minute with a $95 monthly minimum. Move to a bundle at renewal when call volume picks up.
            </p>
          </div>
        </div>
      </div>

    </div>
  </div>

  <FinalCta />
</MainLayout>

<script>
  const tradeBtns = document.querySelectorAll('.trade-nav-btn');
  const panels: Record<string, HTMLElement | null> = {
    plumbing: document.getElementById('panel-plumbing'),
    hvac: document.getElementById('panel-hvac'),
    electrical: document.getElementById('panel-electrical'),
  };

  tradeBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const tab = btn.getAttribute('data-trade-tab') || 'plumbing';

      tradeBtns.forEach((b) => {
        b.classList.remove('bg-deep-green', 'text-white', 'shadow-xs');
        b.classList.add('text-slate');
      });
      btn.classList.add('bg-deep-green', 'text-white', 'shadow-xs');
      btn.classList.remove('text-slate');

      Object.keys(panels).forEach((key) => {
        if (key === tab) {
          panels[key]?.classList.remove('hidden');
        } else {
          panels[key]?.classList.add('hidden');
        }
      });
    });
  });
</script>

