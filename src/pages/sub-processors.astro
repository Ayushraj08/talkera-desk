---
import LegalLayout from '../layouts/LegalLayout.astro';
import site from '@content/site.json';

const subProcessors = [
  {
    name: "Twilio / Telnyx",
    role: "Telephony Carrier & SMS Gateway",
    location: "United States & Global",
    data: "Telephone numbers, call metadata, SMS text dispatch content"
  },
  {
    name: "Voice Platform Providers (Retell AI / Vapi)",
    role: "Voice Agent Orchestration & STT/TTS",
    location: "United States",
    data: "Call audio streams, speech transcription"
  },
  {
    name: "Language Model Providers (Anthropic / OpenAI)",
    role: "Intent Triage & Natural Language Understanding",
    location: "United States",
    data: "Transcript text for triage extraction (zero training on customer data)"
  },
  {
    name: "Cloudflare Inc.",
    role: "Website Hosting, Edge CDN & DNS Security",
    location: "Global",
    data: "Aggregated visit analytics, edge request routing"
  },
  {
    name: "Google Workspace",
    role: "Business Email & Calendar Synchronization",
    location: "United States & Global",
    data: "Business correspondence, customer appointment records"
  },
  {
    name: "Payment Gateways (Stripe / Razorpay)",
    role: "Commercial Invoicing & Merchant Processing",
    location: "United States & India",
    data: "Billing addresses, commercial subscription status, payment tokens"
  }
];
---

<LegalLayout
  title="Third-Party Sub-processors"
  description="Approved infrastructure, telephony, and language processing sub-processors utilized by Talkera Desk."
  currentSlug="sub-processors"
  lastUpdated="October 2026"
>
  <div class="space-y-6 text-xs sm:text-sm text-slate leading-relaxed">
    <p class="italic text-ink font-semibold">
      Talkera Desk engages the following infrastructure providers to deliver telephony, AI voice synthesis, and hosting services. We provide active customers 30 days prior notice before introducing new sub-processors.
    </p>

    <!-- Mobile horizontal scroll hint -->
    <div class="sm:hidden flex items-center justify-between text-[11px] font-mono text-slate bg-paper px-3 py-1.5 rounded-lg border border-sky-blue/60">
      <span>Scroll horizontally to view sub-processors &rarr;</span>
      <span class="text-deep-green font-bold">&bull; Swipe</span>
    </div>

    <div class="table-responsive-wrapper border border-sky-blue rounded-2xl bg-white shadow-2xs font-mono text-xs">
      <table class="w-full min-w-[640px] divide-y divide-sky-blue/60">
        <thead class="bg-paper text-ink-deep font-heading font-bold">
          <tr>
            <th class="py-3.5 px-5 text-left min-w-[150px]">Provider</th>
            <th class="py-3.5 px-5 text-left min-w-[180px]">Purpose / Functional Role</th>
            <th class="py-3.5 px-5 text-left min-w-[140px]">Location</th>
            <th class="py-3.5 px-5 text-left min-w-[170px]">Data Categories Involved</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 text-slate">
          {subProcessors.map((sp) => (
            <tr class="hover:bg-light-blue/20">
              <td class="py-3.5 px-5 font-bold text-ink-deep font-sans">{sp.name}</td>
              <td class="py-3.5 px-5 font-sans">{sp.role}</td>
              <td class="py-3.5 px-5 text-gray-500">{sp.location}</td>
              <td class="py-3.5 px-5 font-sans text-[11px]">{sp.data}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="p-4 rounded-xl bg-paper border border-sky-blue text-xs text-slate">
      <strong class="text-ink-deep">Data Protection Commitment:</strong> All sub-processors are vetted for SOC 2, ISO 27001, and GDPR compliance. Where third-party language models are utilized, our commercial agreements prohibit providers from using client phone audio or transcripts to train public models.
    </div>
  </div>
</LegalLayout>
