---
import MainLayout from '../layouts/MainLayout.astro';
import PlanFinder from '../components/pricing/PlanFinder.astro';
import pricing from '@content/pricing.json';
---

<MainLayout
  title="Talkera Desk Pricing | From $59 a Month, No Contract"
  description="Every plan and charge, in one page. Pay as you go or bundled minutes. Month to month, cancel with 30 days notice."
  canonicalUrl="https://talkeradesk.com/pricing"
>
  <div class="py-16 lg:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Top Section Header -->
      <div class="max-w-3xl mb-12">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-light-blue border border-sky-blue text-xs font-semibold text-deep-green uppercase tracking-wider font-mono mb-4">
          Public Fee Schedule
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-ink-deep tracking-tight mb-4">
          Straightforward pricing.<br />No contracts.
        </h1>
        
        <!-- Dated Quotable Sentence -->
        <p class="text-base sm:text-lg text-slate leading-relaxed font-medium">
          {pricing.datedSentence}
        </p>
        <p class="text-xs text-gray-500 font-mono mt-2">
          Zero card surcharges. Zero GST charged on international exports under valid LUT.
        </p>
      </div>

      <!-- 4 Plan Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
        {pricing.plans.map((pl) => (
          <div
            class={`rounded-panel p-7 flex flex-col justify-between transition-all duration-300 relative ${
              pl.highlight
                ? 'bg-deep-green text-white shadow-xl ring-2 ring-lime-accent hover:-translate-y-2 hover:shadow-2xl dark-glass-bezel'
                : 'bg-paper text-ink border border-sky-blue shadow-tactile hover:-translate-y-2 hover:border-deep-green hover:shadow-xl glass-bezel'
            }`}
          >
            {pl.badge && (
              <div class="absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-0.5 rounded-full bg-lime-accent text-ink-deep text-[11px] font-mono font-bold tracking-wider uppercase shadow-sm">
                {pl.badge}
              </div>
            )}

            <div>
              <div class={`text-xs font-mono uppercase tracking-wider mb-2 font-semibold ${pl.highlight ? 'text-lime-accent' : 'text-brand-green'}`}>
                {pl.name}
              </div>
              <div class="flex items-baseline gap-1 my-3">
                <span class={`text-4xl font-extrabold font-heading tabular tracking-tight ${pl.highlight ? 'text-white' : 'text-ink-deep'}`}>
                  ${pl.monthlyFee}
                </span>
                <span class={`text-xs font-mono ${pl.highlight ? 'text-white' : 'text-slate'}`}>
                  / month
                </span>
              </div>
              <p class={`text-xs mb-6 ${pl.highlight ? 'text-white' : 'text-slate'}`}>
                {pl.tagline}
              </p>

              <!-- Detailed Metrics Spec Table (Left text, Right numbers strictly aligned) -->
              <div class={`space-y-2 py-4 border-t border-b text-xs font-mono mb-6 ${pl.highlight ? 'border-white/20' : 'border-sky-blue/60'}`}>
                <div class="flex justify-between items-baseline gap-2 py-0.5">
                  <span class={`text-left shrink-0 ${pl.highlight ? 'text-white' : 'text-slate'}`}>Included Minutes:</span>
                  <span class={`font-bold tabular text-right whitespace-nowrap ${pl.highlight ? 'text-white' : 'text-ink-deep'}`}>{pl.includedMin === 0 ? 'Pay as used' : `${pl.includedMin} mins`}</span>
                </div>
                <div class="flex justify-between items-baseline gap-2 py-0.5">
                  <span class={`text-left shrink-0 ${pl.highlight ? 'text-white' : 'text-slate'}`}>Estimated Calls:</span>
                  <span class={`font-bold tabular text-right whitespace-nowrap ${pl.highlight ? 'text-white' : 'text-ink-deep'}`}>{pl.estimatedCalls}</span>
                </div>
                <div class="flex justify-between items-baseline gap-2 py-0.5">
                  <span class={`text-left shrink-0 ${pl.highlight ? 'text-white' : 'text-slate'}`}>Effective Per-Min:</span>
                  <span class={`font-bold tabular text-right whitespace-nowrap ${pl.highlight ? 'text-lime-accent' : 'text-brand-green'}`}>
                    {pl.includedMin === 0 ? '$0.600 / min' : `$${(pl.monthlyFee / pl.includedMin).toFixed(3)} / min`}
                  </span>
                </div>
                <div class="flex justify-between items-baseline gap-2 py-0.5">
                  <span class={`text-left shrink-0 ${pl.highlight ? 'text-white' : 'text-slate'}`}>Extra Minutes:</span>
                  <span class={`font-bold tabular text-right whitespace-nowrap ${pl.highlight ? 'text-white' : 'text-ink-deep'}`}>$0.60 / min</span>
                </div>
                <div class="flex justify-between items-baseline gap-2 py-0.5">
                  <span class={`text-left shrink-0 ${pl.highlight ? 'text-white' : 'text-slate'}`}>Calls At Once:</span>
                  <span class={`font-bold tabular text-right whitespace-nowrap ${pl.highlight ? 'text-white' : 'text-ink-deep'}`}>{pl.concurrentCalls === 1 ? '1 call' : `${pl.concurrentCalls} calls`}</span>
                </div>
                <div class="flex justify-between items-baseline gap-2 py-0.5">
                  <span class={`text-left shrink-0 ${pl.highlight ? 'text-white' : 'text-slate'}`}>Setup (One-Time):</span>
                  <span class={`font-bold tabular text-right whitespace-nowrap ${pl.highlight ? 'text-white' : 'text-ink-deep'}`}>${pl.setupFee}</span>
                </div>
                <div class="flex justify-between items-baseline gap-2 py-0.5">
                  <span class={`text-left shrink-0 ${pl.highlight ? 'text-white' : 'text-slate'}`}>Included SMS:</span>
                  <span class={`font-bold tabular text-right whitespace-nowrap ${pl.highlight ? 'text-white' : 'text-ink-deep'}`}>{pl.textModel}</span>
                </div>
                <div class="flex justify-between items-baseline gap-2 py-0.5">
                  <span class={`text-left shrink-0 ${pl.highlight ? 'text-white' : 'text-slate'}`}>Audio Retention:</span>
                  <span class={`font-bold tabular text-right whitespace-nowrap ${pl.highlight ? 'text-white' : 'text-ink-deep'}`}>{pl.retentionDays} days</span>
                </div>
                <div class={`text-[10px] pt-1.5 border-t ${pl.highlight ? 'border-white/10 text-white font-medium' : 'border-sky-blue/40 text-slate/80'} italic`}>
                  * Calls estimated at ~3 mins average duration.
                </div>
              </div>

              <!-- Feature Bullets -->
              <ul class="space-y-2.5 text-xs mb-8">
                {pl.features.map((f) => (
                  <li class="flex items-start gap-2">
                    <span class={`font-bold mt-0.5 ${pl.highlight ? 'text-lime-accent' : 'text-brand-green'}`}>&check;</span>
                    <span class={pl.highlight ? 'text-white' : 'text-slate'}>{f}</span>
                  </li>
                ))}
              </ul>
            </div>

            <a
              href={`mailto:support@talkeradesk.com?subject=Inquiry%20regarding%20Talkera%20Desk%20${encodeURIComponent(pl.name)}%20Plan`}
              class={`w-full py-3.5 px-4 rounded-full text-xs font-bold text-center transition-all ${
                pl.highlight
                  ? 'bg-lime-accent text-ink-deep hover:bg-[#E5FAA0] shadow'
                  : 'bg-deep-green text-white hover:bg-brand-green'
              }`}
            >
              Get Started with {pl.name}
            </a>
          </div>
        ))}
      </div>

      <!-- Ramp-Style Interactive 3-Tab Plan Finder (Spec C5) -->
      <PlanFinder />

      <!-- Add-Ons Table (Spec C4) -->
      <div class="my-20">
        <div class="max-w-2xl mb-8">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-light-blue border border-sky-blue text-xs font-mono font-bold text-deep-green uppercase tracking-wider mb-2">
            Configurable Add-ons
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-ink-deep font-heading">
            Add-ons and optional expansions
          </h2>
          <p class="text-xs sm:text-sm text-slate mt-1">
            Anything not included in your base plan is quoted in writing and approved by you before implementation.
          </p>
        </div>

        <div class="md:hidden flex items-center gap-1.5 text-[11px] font-mono text-slate mb-2.5 px-1">
          <svg class="w-3.5 h-3.5 text-brand-green shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          <span>Scroll horizontally to view all add-ons &rarr;</span>
        </div>
        <div class="border border-sky-blue rounded-2xl overflow-hidden bg-white shadow-tactile">
          <div class="table-responsive-wrapper">
            <table class="min-w-full divide-y divide-sky-blue/60 text-xs">
              <thead class="bg-paper text-ink-deep font-heading font-bold">
                <tr>
                  <th class="py-4 px-5 text-left min-w-[160px]">Add-on Item</th>
                  <th class="py-4 px-4 text-left min-w-[130px]">US Dollar Rate</th>
                  <th class="py-4 px-5 text-left min-w-[220px]">Description</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100 font-mono text-slate">
                {pricing.addons.map((add) => (
                  <tr class="hover:bg-light-blue/20 transition-colors">
                    <td class="py-4 px-5 font-bold text-ink-deep font-sans">{add.name}</td>
                    <td class="py-4 px-4 font-bold text-deep-green">{add.price}</td>
                    <td class="py-4 px-5 font-sans text-xs">{add.desc}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Pulse, Burst, and Rollover Architecture Explainer -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 my-16">
        <div class="p-6 rounded-2xl bg-paper border border-sky-blue">
          <div class="text-xs font-mono text-deep-green font-bold uppercase mb-2">60-Second Pulse</div>
          <h3 class="font-heading font-bold text-lg text-ink-deep mb-2">How We Bill Call Time</h3>
          <p class="text-xs text-slate leading-relaxed">
            Our billing pulse is 60 seconds: every started minute counts as a minute. Calls under 10 seconds are zero charge. With trade calls averaging 3.5 minutes, expect roughly 4 billed minutes per call.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-paper border border-sky-blue">
          <div class="text-xs font-mono text-deep-green font-bold uppercase mb-2">Zero Burst Fees</div>
          <h3 class="font-heading font-bold text-lg text-ink-deep mb-2">Handling Storm Surges</h3>
          <p class="text-xs text-slate leading-relaxed">
            Many vendors penalize emergency surges with inflated per-minute fees. We charge zero burst fees. Callers exceeding your concurrent channels get an instant text holding their place.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-paper border border-sky-blue">
          <div class="text-xs font-mono text-deep-green font-bold uppercase mb-2">20% Minute Rollover</div>
          <h3 class="font-heading font-bold text-lg text-ink-deep mb-2">Quiet Month Protection</h3>
          <p class="text-xs text-slate leading-relaxed">
            Unused included minutes carry over to the next period once, up to 20% of your plan's included minutes (Core 100, Growth 200, Command 500). They roll over automatically.
          </p>
        </div>
      </div>

      <!-- 72-Hour Fix Credit SLA & Support Policy (Spec C4 / Part 0) -->
      <div id="sla" class="p-8 rounded-panel bg-deep-green text-white noise-overlay relative overflow-hidden my-16 shadow-tactile">
        <div class="relative z-10 max-w-3xl">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-lime-accent/20 text-lime-accent text-xs font-mono font-bold mb-4">
            Service Level Agreement
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold font-heading text-white mb-3">
            The 72-Hour Fix Credit Policy
          </h2>
          <p class="text-xs sm:text-sm text-gray-200 leading-relaxed mb-6">
            When you report a problem, our engineering team begins diagnosing at once and fixes it as soon as possible, up to 72 hours at most. If the cause is on our side and the resolution takes more than 24 hours, each additional day (rounded up to a whole day) is added directly to your plan as a service credit.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs font-mono text-gray-300 pt-4 border-t border-white/20">
            <div>
              <strong class="text-lime-accent block mb-0.5">What is covered:</strong>
              Our setup, our prompt logic, our webhook code, our delays.
            </div>
            <div>
              <strong class="text-lime-accent block mb-0.5">Turnaround expectation:</strong>
              We ask you to answer verification questions within 2 to 3 hours during your business day.
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</MainLayout>
