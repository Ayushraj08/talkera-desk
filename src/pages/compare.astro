---
import MainLayout from '../layouts/MainLayout.astro';
import FinalCta from '../components/home/FinalCta.astro';

// Operational factors for comparison
const operationalFactors = [
  {
    factor: 'The Scaling Ceiling',
    inHouse: 'Takes 1 call at a time. Extra callers go to voicemail or call a competitor.',
    offshore: 'Takes 1 call at a time. High nocturnal fatigue during local business hours.',
    talkera: 'Multi-line capacity (2, 3, 5, or 8+ simultaneous calls). Zero busy signals.'
  },
  {
    factor: 'Data Security & Privacy',
    inHouse: 'Controlled on office equipment under domestic jurisdiction.',
    offshore: 'Vulnerable: Personal home laptops, residential Wi-Fi, no enterprise controls.',
    talkera: 'Direct CRM API sync, SOC2-compliant telephony, prompt safety guardrails.'
  },
  {
    factor: 'Infrastructure Reliability',
    inHouse: 'Requires physical desk, workstation, and office overhead.',
    offshore: 'Prone to local brownouts, power cuts, and residential ISP drops.',
    talkera: 'Cloud carrier telephony with 24/7 carrier redundancy and failover routing.'
  },
  {
    factor: 'Management Burden',
    inHouse: 'HR friction, performance reviews, sick days, vacations, and payroll processing.',
    offshore: 'High turnover. If an independent freelancer quits, phones go dark immediately.',
    talkera: 'We build, tune, audit, and support your agent. Zero HR friction on your desk.'
  }
];

// Market Frustrations
const frustrations = [
  {
    title: 'Nobody Owns the Result',
    desc: 'Software vendors sell per-minute bundles or self-serve access, but when a call drops or an address is booked incorrectly, no one is accountable for tuning it.'
  },
  {
    title: 'Wrong Bookings & Technical Errors',
    desc: 'Generic bots schedule appointments in the middle of travel routes or book complex extractions when crews only handle standard diagnostics.'
  },
  {
    title: 'Surprise Bills & Surge Fees',
    desc: 'Complicated overage formulas and sudden burst penalties when severe weather strikes make monthly bills unpredictable.'
  },
  {
    title: 'Weak Escalation Handoffs',
    desc: 'When an emergency homeowner needs immediate help, automated tools often loop or deliver dead silence instead of dialing on-call staff.'
  },
  {
    title: 'Annual Contract Lock-in',
    desc: 'Enterprise platforms force trade companies into expensive 12-month commitments before proving performance on real customer calls.'
  },
  {
    title: 'Data & Number Hostage',
    desc: 'Many services hold onto telephone numbers or refuse clean data exports when a contractor decides to take dispatch in-house.'
  }
];
---

<MainLayout
  title="Compare AI Receptionist Pricing & Labor Models | Talkera Desk"
  description="Compare published prices and inclusions for Talkera Desk vs competitors, in-house staff, and offshore freelancers. Short, clear, and honest."
  canonicalUrl="https://talkeradesk.com/compare"
>
  <div class="py-16 lg:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20 lg:space-y-28">

      <!-- Section 1: Hero & Competitor Table -->
      <div>
        <div class="max-w-3xl mb-10">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-light-blue border border-sky-blue text-xs font-semibold text-deep-green uppercase tracking-wider font-mono mb-4">
            Transparent Market Comparison
          </div>
          <h1 class="text-4xl sm:text-5xl font-extrabold text-ink-deep tracking-tight font-heading">
            Compare published plans
          </h1>
          <p class="text-base text-slate mt-2 leading-relaxed">
            Published rates and inclusions from each provider's official pricing page.
          </p>
        </div>

        <!-- Single Benchmark Table (U3) -->
        <div class="overflow-x-auto border border-sky-blue rounded-2xl shadow-tactile bg-white">
          <table class="min-w-[960px] w-full text-xs sm:text-sm">
            <thead class="bg-paper border-b border-sky-blue/70">
              <tr>
                <th class="p-4 text-left font-mono font-bold text-slate uppercase text-xs">Feature / Plan</th>
                <th class="p-4 text-left font-bold text-deep-green bg-light-blue/40 border-x border-sky-blue">Talkera Desk</th>
                <th class="p-4 text-left font-bold text-ink-deep">Frontdesk</th>
                <th class="p-4 text-left font-bold text-ink-deep">FirstCall AI</th>
                <th class="p-4 text-left font-bold text-ink-deep">Voco (UK)</th>
                <th class="p-4 text-left font-bold text-ink-deep">Smith.ai (AI-first)</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-sky-blue/50">
              <!-- Prominently Highlighted: Per Minute Charges (Replaces Entry Price) -->
              <tr class="bg-light-blue/40 border-b-2 border-deep-green/30">
                <th class="p-4 text-left align-top">
                  <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-deep-green text-white font-mono font-bold text-xs uppercase tracking-wider shadow-2xs">
                    Per minute charges
                  </div>
                </th>
                <td class="p-4 align-top bg-light-blue/60 border-x border-sky-blue">
                  <div class="text-base sm:text-lg font-extrabold text-deep-green tracking-tight">Talkera Desk Pro - $0.450</div>
                  <div class="text-xs text-slate mt-0.5">$581 / mo for 1,292 included minutes</div>
                </td>
                <td class="p-4 align-top">
                  <div class="text-base sm:text-lg font-bold text-ink-deep">$0.495</div>
                  <div class="text-xs text-slate mt-0.5">Frontdesk ($99 for 200 min)</div>
                </td>
                <td class="p-4 align-top">
                  <div class="text-base sm:text-lg font-bold text-ink-deep">FirstCall AI Business: $0.166</div>
                  <div class="text-xs text-slate mt-0.5">$249 for 1,500 min</div>
                </td>
                <td class="p-4 align-top">
                  <div class="text-base sm:text-lg font-bold text-ink-deep">Voco Enterprise: 29p <span class="text-xs font-normal text-slate">(excl. VAT)</span></div>
                  <div class="text-xs text-slate mt-0.5">£499 for 1,719 min</div>
                </td>
                <td class="p-4 align-top">
                  <div class="text-base sm:text-lg font-bold text-ink-deep">Smith.ai Enterprise: $1.67 a call</div>
                  <div class="text-xs text-slate mt-0.5">No per-minute price ($500 for 300 calls)</div>
                </td>
              </tr>

              {[
                ['Bigger plans', 'Growth $383 for 743 minutes, Pro $581 for 1,292, Expansion $950 for 1,994', 'Custom after the one plan', 'Pro $99 for 500 minutes, Business $249 for 1,500', '£99 for 300 minutes, £499 for 1,719', 'Enterprise $500 for 300 calls'],
                ['Extra minutes', '$0.59, $0.50 or $0.41 by plan', '$0.25 a minute', 'Not stated', '36p, 33p or 29p by plan', 'Billed per call, not per minute: $2.50 on Pro, $2.17 on Enterprise'],
                ['Texts and WhatsApp alerts', 'In the price, up to the allowance', '400 texts in the price, more billed from credits', 'Not stated', 'Texts and WhatsApp replies on every plan', 'Not stated'],
                ['Set-up', 'We build it for you in up to 3 days, no fee', 'Not stated', 'Not stated', 'Free', 'Pro: you set it up with their help. Enterprise: they build it'],
                ['A person reviews your calls', 'Yes, by plan', 'Not stated', 'Not stated', 'Not stated', 'Enterprise: human quality control'],
                ['Free trial', 'None. Start with Pay As You Go', '7 days', 'Not stated', 'Not stated for phone plans', 'Free plan with 25 calls'],
                ['Contract', 'None', 'Not stated', 'Not stated', 'None', 'Not stated']
              ].map((row) => (
                <tr class="hover:bg-paper/50 transition-colors">
                  <th class="p-4 text-left font-semibold text-ink-deep align-top">{row[0]}</th>
                  <td class="p-4 align-top font-semibold text-deep-green bg-light-blue/20 border-x border-sky-blue/60">{row[1]}</td>
                  <td class="p-4 align-top text-slate">{row[2]}</td>
                  <td class="p-4 align-top text-slate">{row[3]}</td>
                  <td class="p-4 align-top text-slate">{row[4]}</td>
                  <td class="p-4 align-top text-slate">{row[5]}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="text-xs text-slate mt-4 font-mono">
          Prices from each company's own pricing page, checked 23 Oct 2026.
        </p>

        <!-- Three lines under the table (the only persuasion on the page) -->
        <div class="max-w-3xl mt-8 space-y-3 text-sm sm:text-base text-ink-deep leading-relaxed font-medium">
          <p>1. We are not the cheapest per minute, and we say so. If a $99 tool does what you need, buy it.</p>
          <p>2. Cheaper per minute is not cheaper per booked job. Your price covers a build around your workflow, the number, texts and WhatsApp alerts, the tool connection, upkeep and a person who reviews your calls.</p>
          <p>3. Many tools sell the agent first and add the rest later. Check what any price really covers.</p>
        </div>
      </div>

      <!-- Section 2: True Labor Cost Breakdown (In-House vs Offshore vs Talkera) -->
      <div>
        <div class="max-w-3xl mb-10">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-light-blue border border-sky-blue text-xs font-semibold text-deep-green uppercase tracking-wider font-mono mb-4">
            True Labor Cost Breakdown
          </div>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-ink-deep tracking-tight font-heading mb-3">
            In-House Staff vs. Offshore Freelancer vs. Talkera Desk
          </h2>
          <p class="text-sm sm:text-base text-slate leading-relaxed">
            Running an efficient call-answering desk requires looking at <strong class="text-ink-deep">true productive talk time</strong>. An average inbound trade lead takes 3 to 5 minutes. Below is the honest math and the hidden organizational costs companies absorb.
          </p>
        </div>

        <!-- 3 Labor Model Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
          
          <!-- Model 1: Local In-House Staff -->
          <div class="p-6 rounded-2xl bg-paper border border-sky-blue flex flex-col justify-between shadow-2xs">
            <div>
              <span class="text-xs font-mono font-bold text-slate uppercase tracking-wider">Model 1: Local Employee</span>
              <h3 class="font-heading font-bold text-xl text-ink-deep mt-2 mb-1">In-House Staff</h3>
              <p class="text-xs text-slate mb-5">US Federal minimum wage ($7.25/hr + 15% mandatory taxes = ~$8.34/hr gross).</p>

              <dl class="space-y-2 text-xs font-mono border-t border-sky-blue/60 pt-4">
                <div class="flex justify-between"><dt class="text-slate">Gross Base Rate:</dt><dd class="font-bold text-ink-deep">$0.087 / min</dd></div>
                <div class="flex justify-between"><dt class="text-slate">Real Rate (50% Occupancy):</dt><dd class="font-bold text-red-600">$0.170 / min</dd></div>
                <div class="flex justify-between"><dt class="text-slate">Effective Monthly Labor:</dt><dd class="font-bold text-ink-deep">~$1,334 / mo</dd></div>
              </dl>
            </div>
            <p class="text-xs text-slate mt-5 pt-3 border-t border-sky-blue/60 leading-relaxed">
              <strong class="text-ink-deep">The Reality:</strong> An in-house receptionist is rarely on the phone for an entire 8-hour shift. At realistic 50% call occupancy, the effective cost spikes to $0.17/min plus benefits.
            </p>
          </div>

          <!-- Model 2: Offshore Freelancer -->
          <div class="p-6 rounded-2xl bg-paper border border-sky-blue flex flex-col justify-between shadow-2xs">
            <div>
              <span class="text-xs font-mono font-bold text-slate uppercase tracking-wider">Model 2: Overseas Contractor</span>
              <h3 class="font-heading font-bold text-xl text-ink-deep mt-2 mb-1">Offshore Freelancer</h3>
              <p class="text-xs text-slate mb-5">Minimum viable rate for an offshore virtual receptionist ($5.00/hr in Philippines or India).</p>

              <dl class="space-y-2 text-xs font-mono border-t border-sky-blue/60 pt-4">
                <div class="flex justify-between"><dt class="text-slate">Gross Base Rate:</dt><dd class="font-bold text-ink-deep">$0.052 / min</dd></div>
                <div class="flex justify-between"><dt class="text-slate">Real Rate (50% Occupancy):</dt><dd class="font-bold text-amber-600">$0.100 / min</dd></div>
                <div class="flex justify-between"><dt class="text-slate">Effective Monthly Labor:</dt><dd class="font-bold text-ink-deep">~$800 / mo</dd></div>
              </dl>
            </div>
            <p class="text-xs text-slate mt-5 pt-3 border-t border-sky-blue/60 leading-relaxed">
              <strong class="text-ink-deep">The Reality:</strong> Avoids payroll taxes, but nocturnal fatigue during US/UK/AU business hours and constant turnover require ongoing recruiting, training, and QA.
            </p>
          </div>

          <!-- Model 3: Talkera Desk -->
          <div class="p-6 rounded-2xl bg-white border-2 border-deep-green flex flex-col justify-between shadow-lg relative">
            <span class="absolute -top-3 right-4 px-2.5 py-0.5 rounded-full bg-deep-green text-lime-accent text-[11px] font-mono font-bold tracking-wide uppercase">
              Managed AI Phone Team
            </span>
            <div>
              <span class="text-xs font-mono font-bold text-brand-green uppercase tracking-wider">Model 3: Done-For-You AI</span>
              <h3 class="font-heading font-bold text-xl text-ink-deep mt-2 mb-1">Talkera Desk</h3>
              <p class="text-xs text-slate mb-5">Pay strictly for active call minutes. Zero payroll, zero idle minutes, zero shift constraints.</p>

              <dl class="space-y-2 text-xs font-mono border-t border-sky-blue/60 pt-4">
                <div class="flex justify-between"><dt class="text-slate">All-Inclusive Rate:</dt><dd class="font-bold text-deep-green">$0.410 to $0.590 / min</dd></div>
                <div class="flex justify-between"><dt class="text-slate">Idle Time Billed:</dt><dd class="font-bold text-deep-green">$0.00 (Zero)</dd></div>
                <div class="flex justify-between"><dt class="text-slate">Starting Monthly Base:</dt><dd class="font-bold text-deep-green">From $95 / mo</dd></div>
              </dl>
            </div>
            <p class="text-xs text-slate mt-5 pt-3 border-t border-sky-blue/60 leading-relaxed">
              <strong class="text-ink-deep">The Talkera Advantage:</strong> You only pay for exact productive call seconds. Multiple concurrent lines answer simultaneously 24/7 with zero management overhead.
            </p>
          </div>

        </div>

        <!-- Hidden Costs Strip -->
        <div class="p-6 sm:p-8 rounded-2xl bg-white border border-sky-blue mb-12 shadow-sm">
          <h3 class="text-base sm:text-lg font-heading font-bold text-ink-deep mb-2">
            The Hidden "Extra" Costs That Human Labor Demands
          </h3>
          <p class="text-xs sm:text-sm text-slate mb-6">
            Beyond basic wages, businesses must absorb these recurring technical and operational expenses to execute phone answering:
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-xs">
            <div class="p-4 rounded-xl bg-paper border border-sky-blue">
              <div class="font-mono font-bold text-ink-deep mb-1">1. VOIP Licenses</div>
              <div class="text-red-600 font-mono font-bold mb-1.5">+$20 to $35 / user / mo</div>
              <p class="text-slate text-[11px] leading-relaxed">Dialer lines and seat licenses for RingCentral or Zoom Workplace.</p>
            </div>
            <div class="p-4 rounded-xl bg-paper border border-sky-blue">
              <div class="font-mono font-bold text-ink-deep mb-1">2. CRM User Seats</div>
              <div class="text-red-600 font-mono font-bold mb-1.5">+$15 to $30 / user / mo</div>
              <p class="text-slate text-[11px] leading-relaxed">Seat licenses on HubSpot, Jobber, Zoho, or ServiceTitan to enter bookings.</p>
            </div>
            <div class="p-4 rounded-xl bg-paper border border-sky-blue">
              <div class="font-mono font-bold text-ink-deep mb-1">3. SMS Gateways</div>
              <div class="text-red-600 font-mono font-bold mb-1.5">API routing carrier fees</div>
              <p class="text-slate text-[11px] leading-relaxed">Twilio/Plivo fees ($0.0079 to $0.011/SMS) for tech dispatch texts.</p>
            </div>
            <div class="p-4 rounded-xl bg-paper border border-sky-blue">
              <div class="font-mono font-bold text-ink-deep mb-1">4. Taxes & FX Spreads</div>
              <div class="text-red-600 font-mono font-bold mb-1.5">+5% fee + 4% FX spread</div>
              <p class="text-slate text-[11px] leading-relaxed">Platform marketplace fees, contract initiation, and currency spreads.</p>
            </div>
          </div>
        </div>

        <!-- Operational Comparison Table -->
        <div class="overflow-x-auto border border-sky-blue rounded-2xl shadow-tactile bg-white">
          <table class="min-w-[800px] w-full text-xs sm:text-sm">
            <thead class="bg-paper border-b border-sky-blue/70">
              <tr>
                <th class="p-4 text-left font-mono font-bold text-slate uppercase text-xs w-1/4">Operational Factor</th>
                <th class="p-4 text-left font-bold text-ink-deep w-1/4">In-House Local Employee</th>
                <th class="p-4 text-left font-bold text-ink-deep w-1/4">Offshore Freelancer</th>
                <th class="p-4 text-left font-bold text-deep-green bg-light-blue/40 border-l border-sky-blue w-1/4">Talkera Desk AI Team</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-sky-blue/50">
              {operationalFactors.map((row) => (
                <tr class="hover:bg-paper/50 transition-colors">
                  <th class="p-4 text-left font-bold text-ink-deep align-top">{row.factor}</th>
                  <td class="p-4 align-top text-slate">{row.inHouse}</td>
                  <td class="p-4 align-top text-red-700/80">{row.offshore}</td>
                  <td class="p-4 align-top font-semibold text-deep-green bg-light-blue/20 border-l border-sky-blue/60">{row.talkera}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Section 3: What is Missing from Legacy Tools (Market Frustrations) -->
      <div>
        <div class="max-w-3xl mb-10">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-light-blue border border-sky-blue text-xs font-semibold text-deep-green uppercase tracking-wider font-mono mb-4">
            Market Frustrations
          </div>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-ink-deep tracking-tight font-heading mb-3">
            What is missing from legacy tools
          </h2>
          <p class="text-sm sm:text-base text-slate leading-relaxed">
            Contractors frequently share these recurring complaints in trade forums regarding traditional answering services and bot tools.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {frustrations.map((item) => (
            <div class="p-6 rounded-2xl bg-paper border border-sky-blue shadow-2xs flex flex-col justify-between">
              <div>
                <h3 class="font-heading font-bold text-base text-ink-deep mb-2">{item.title}</h3>
                <p class="text-xs sm:text-sm text-slate leading-relaxed">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Section 4: When Talkera Desk is NOT the right fit (Clear Qualification) -->
      <div class="p-8 sm:p-10 rounded-3xl bg-paper border border-sky-blue shadow-sm max-w-4xl">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-10 h-10 rounded-xl bg-deep-green text-lime-accent flex items-center justify-center font-bold text-lg shrink-0">
            !
          </div>
          <div>
            <h2 class="text-xl sm:text-2xl font-bold font-heading text-ink-deep">
              When Talkera Desk is NOT the right fit
            </h2>
            <p class="text-xs sm:text-sm text-slate mt-0.5">
              We believe in transparent qualification rather than selling you something you don't need.
            </p>
          </div>
        </div>

        <ul class="space-y-4 text-xs sm:text-sm text-slate leading-relaxed">
          <li class="flex items-start gap-3">
            <span class="w-1.5 h-1.5 rounded-full bg-deep-green shrink-0 mt-2"></span>
            <div>
              <strong class="text-ink-deep">You are looking for a cheap $49 tool / basic voicemail transcription:</strong>
              {" "}If you receive very few calls and just need text logs of voicemails, buy a $49 software tool. Talkera Desk is an active, fully managed call-answering service that triages emergencies and books appointments directly.
            </div>
          </li>
          <li class="flex items-start gap-3">
            <span class="w-1.5 h-1.5 rounded-full bg-deep-green shrink-0 mt-2"></span>
            <div>
              <strong class="text-ink-deep">You demand a live human on every call:</strong>
              {" "}If you believe AI voice agents are not right for your brand under any circumstance, use a traditional human call center.
            </div>
          </li>
          <li class="flex items-start gap-3">
            <span class="w-1.5 h-1.5 rounded-full bg-deep-green shrink-0 mt-2"></span>
            <div>
              <strong class="text-ink-deep">You handle HIPAA health records in the US:</strong>
              {" "}We do not service healthcare triage or medical clinics without a custom signed business associate agreement.
            </div>
          </li>
        </ul>
      </div>

    </div>
  </div>

  <FinalCta />
</MainLayout>
