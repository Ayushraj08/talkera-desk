---
import MainLayout from '../layouts/MainLayout.astro';
import FinalCta from '../components/home/FinalCta.astro';
import faqs from '@content/faq.json';

const categories = ["All", ...Array.from(new Set(faqs.map(f => f.category)))];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer
    }
  }))
};
---

<MainLayout
  title="Talkera Desk FAQ | Pricing, Calls, Booking, Setup"
  description="Clear answers about what Talkera Desk does, who it serves, pricing, call handling, setup, and support."
  canonicalUrl="https://www.talkeradesk.com/faq"
>
  <!-- Inject FAQPage Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="py-16 lg:py-24 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Page Header -->
      <div class="text-center max-w-3xl mx-auto mb-14">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-ink-deep tracking-tight mb-4">
          Frequently asked questions
        </h1>
        <p class="text-base sm:text-lg text-slate leading-relaxed">
          Answers about Talkera Desk, in plain language.
        </p>
      </div>

      <!-- Category Filter Pills -->
      <div class="flex flex-wrap items-center justify-center gap-2 mb-12">
        {categories.map((cat, idx) => (
          <button
            type="button"
            data-cat={cat}
            class={`faq-filter-btn filter-pill px-3.5 py-1.5 rounded-full text-xs font-sans font-semibold border ${
              idx === 0 ? 'is-active' : ''
            }`}
          >
            {cat}
          </button>
        ))}
      </div>

      <!-- FAQs -->
      <div class="space-y-4" id="faq-list">
        {faqs.map((faq, index) => (
          <details
            name="faq-accordion"
            data-category={faq.category}
            class="faq-item group bg-paper border border-sky-blue rounded-2xl p-6 shadow-2xs open:border-deep-green/60 open:bg-white transition-all"
            open={index === 0}
          >
            <summary class="font-sans font-bold text-base sm:text-lg text-ink-deep cursor-pointer flex items-center justify-between select-none group-hover:text-deep-green">
              <span>{faq.question}</span>
              <span class="w-7 h-7 rounded-full bg-light-blue text-deep-green flex items-center justify-center text-sm font-sans group-open:rotate-180 transition-transform shrink-0 ml-4">
                &darr;
              </span>
            </summary>
            <div class="mt-4 pt-4 border-t border-sky-blue/40 text-xs sm:text-sm text-slate leading-relaxed">
              <p>{faq.answer}</p>
              <div class="mt-3 text-[10px] font-sans uppercase text-gray-400">
                Category: {faq.category}
              </div>
            </div>
          </details>
        ))}
      </div>

    </div>
  </div>

  <FinalCta />
</MainLayout>

<script>
  const filterBtns = document.querySelectorAll('.faq-filter-btn');
  const items = document.querySelectorAll<HTMLDetailsElement>('.faq-item');

  // Filter tabs
  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const selected = btn.getAttribute('data-cat');
      
      filterBtns.forEach(b => b.classList.remove('is-active'));
      btn.classList.add('is-active');

      items.forEach((item) => {
        const cat = item.getAttribute('data-category');
        if (selected === 'All' || cat === selected) {
          item.classList.remove('hidden');
        } else {
          item.classList.add('hidden');
        }
      });
    });
  });

  // Exclusive Accordion behavior: closing other FAQs when one is opened
  items.forEach((detail) => {
    detail.addEventListener('toggle', () => {
      if (detail.open) {
        items.forEach((other) => {
          if (other !== detail && other.open) {
            other.open = false;
          }
        });
      }
    });
  });
</script>

