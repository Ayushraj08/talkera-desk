---
import updates from '@content/updates.json';
---

<section id="how-it-works" class="py-20 lg:py-28 bg-[#F4F8FA] border-b border-sky-blue/60 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-light-blue border border-sky-blue text-xs font-semibold text-deep-green uppercase tracking-wider font-mono mb-4">
        End-to-End Automation Loop
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-ink-deep tracking-tight mb-4">
        {updates.headline}
      </h2>
      <p class="text-base sm:text-lg text-slate leading-relaxed">
        {updates.subhead}
      </p>
    </div>

    <!-- 6-Step Interactive Timeline Scrubber -->
    <div class="mb-12 overflow-x-auto pb-4">
      <div class="flex items-center gap-2 min-w-max p-1.5 bg-white border border-sky-blue rounded-full shadow-xs">
        {updates.steps.map((st, idx) => (
          <button
            type="button"
            data-step-idx={idx}
            class={`phone-timeline-btn px-4 py-2 rounded-full text-xs font-bold font-mono transition-all flex items-center gap-1.5 ${
              idx === 0
                ? 'bg-deep-green text-white shadow-sm hover:bg-brand-green'
                : 'text-slate hover:text-deep-green hover:bg-white hover:shadow-2xs'
            }`}
          >
            <span class="w-2 h-2 rounded-full bg-lime-accent group-[.bg-deep-green]:bg-lime-accent"></span>
            <span>{st.label}</span>
          </button>
        ))}
      </div>
    </div>

    <!-- Mobbin-Style Dual iPhone Hardware Stage -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 max-w-5xl mx-auto">
      
      <!-- Phone A: Homeowner / Caller SMS Thread -->
      <div class="flex flex-col items-center">
        <div class="text-xs font-mono uppercase text-slate font-bold mb-3 tracking-wider flex items-center gap-2">
          <svg class="w-4 h-4 text-brand-green" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
          <span>Phone A: Homeowner's SMS Thread</span>
        </div>

        <!-- iPhone CSS Bezel -->
        <div class="w-full max-w-[340px] rounded-[44px] bg-[#121212] p-3 shadow-2xl border-4 border-[#2C2C2E] relative">
          <!-- Dynamic Island / Speaker notch -->
          <div class="absolute top-5 left-1/2 -translate-x-1/2 w-24 h-4 bg-black rounded-full z-20 flex items-center justify-center">
            <div class="w-2.5 h-2.5 rounded-full bg-[#1A1A1A] mr-3"></div>
            <div class="w-1.5 h-1.5 rounded-full bg-[#0D2818]"></div>
          </div>

          <!-- Screen Container -->
          <div class="bg-white rounded-[34px] overflow-hidden min-h-[460px] flex flex-col justify-between pt-8 pb-4 px-4 text-ink">
            <!-- Messages Header -->
            <div class="text-center pb-3 border-b border-gray-100">
              <div class="w-10 h-10 rounded-full bg-deep-green text-white font-bold text-xs flex items-center justify-center mx-auto mb-1">
                AR
              </div>
              <div class="font-bold text-xs text-ink-deep">Apex Restoration</div>
              <div class="text-[10px] text-gray-400">Automated Dispatch Service</div>
            </div>

            <!-- Message Thread Content -->
            <div class="space-y-3 py-4 flex-1 flex flex-col justify-end">
              <div class="text-center text-[10px] text-gray-400 font-mono" id="phone-a-timestamp">
                Today {updates.steps[0].callerMessage.time}
              </div>

              <!-- SMS Bubble -->
              <div class="bg-light-blue/80 border border-sky-blue/70 text-ink-deep text-xs rounded-2xl rounded-tl-sm p-3.5 leading-relaxed shadow-2xs">
                <p id="phone-a-text">
                  {updates.steps[0].callerMessage.text}
                </p>
              </div>

              <div class="text-right text-[9px] text-gray-400 font-mono">
                Delivered &bull; Reply STOP to cancel
              </div>
            </div>

            <!-- Fake SMS Input -->
            <div class="pt-2 border-t border-gray-100 flex items-center gap-2">
              <div class="flex-1 bg-gray-100 rounded-full px-3 py-1.5 text-xs text-gray-400">
                Text message (SMS)
              </div>
              <div class="w-7 h-7 rounded-full bg-deep-green text-white flex items-center justify-center text-xs">
                &uarr;
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Phone B: Technician & Business Owner Dispatch Feed -->
      <div class="flex flex-col items-center">
        <div class="text-xs font-mono uppercase text-slate font-bold mb-3 tracking-wider flex items-center gap-2">
          <svg class="w-4 h-4 text-deep-green" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="7" width="20" height="14" rx="2" ry="2"/>
            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
          </svg>
          <span>Phone B: Field Crew & Owner Dispatch Feed</span>
        </div>

        <!-- iPhone CSS Bezel -->
        <div class="w-full max-w-[340px] rounded-[44px] bg-[#121212] p-3 shadow-2xl border-4 border-[#2C2C2E] relative">
          <!-- Dynamic Island / Speaker notch -->
          <div class="absolute top-5 left-1/2 -translate-x-1/2 w-24 h-4 bg-black rounded-full z-20 flex items-center justify-center">
            <div class="w-2.5 h-2.5 rounded-full bg-[#1A1A1A] mr-3"></div>
            <div class="w-1.5 h-1.5 rounded-full bg-[#0D2818]"></div>
          </div>

          <!-- Screen Container -->
          <div class="bg-[#0B1E17] text-white rounded-[34px] overflow-hidden min-h-[460px] flex flex-col justify-between pt-8 pb-4 px-4">
            <!-- Messages Header -->
            <div class="text-center pb-3 border-b border-white/10">
              <div class="w-10 h-10 rounded-full bg-lime-accent text-ink-deep font-bold text-xs flex items-center justify-center mx-auto mb-1">
                TD
              </div>
              <div class="font-bold text-xs text-white">Talkera Dispatch Feed</div>
              <div class="text-[10px] text-lime-accent font-mono">Real-time Push to Mike & Owner</div>
            </div>

            <!-- Message Thread Content -->
            <div class="space-y-3 py-4 flex-1 flex flex-col justify-end">
              <div class="text-center text-[10px] text-gray-400 font-mono" id="phone-b-timestamp">
                Today {updates.steps[0].teamMessage.time}
              </div>

              <!-- Dispatch Alert Card Inside Phone -->
              <div class="bg-white/10 border border-white/15 text-white text-xs rounded-2xl p-3.5 leading-relaxed shadow-sm font-mono">
                <div class="text-lime-accent font-bold text-[11px] mb-1 flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                  <span id="phone-b-title">{updates.steps[0].title}</span>
                </div>
                <p class="text-xs text-gray-200" id="phone-b-text">
                  {updates.steps[0].teamMessage.text}
                </p>
              </div>

              <div class="text-right text-[9px] text-emerald-400 font-mono">
                Synced to CRM &bull; High Priority
              </div>
            </div>

            <!-- Fake Tech Action Button -->
            <div class="pt-2 border-t border-white/10 flex items-center justify-between text-xs text-gray-400">
              <span class="text-[11px]">Route: Austin Central</span>
              <span class="px-2.5 py-1 rounded-md bg-lime-accent text-ink font-bold text-[10px]">Acknowledge</span>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Consent & Registration Notice Card -->
    <div class="mt-14 max-w-4xl mx-auto p-5 rounded-2xl bg-white border border-sky-blue text-xs text-slate shadow-sm">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-center md:text-left">
        <div class="flex items-start gap-2.5">
          <div class="w-6 h-6 rounded-full bg-deep-green/10 text-deep-green flex items-center justify-center font-bold shrink-0 mt-0.5">
            &check;
          </div>
          <div>
            <div class="font-bold text-ink-deep">Call-Recorded Consent</div>
            <div>The voice agent asks "Can I text you confirmation?" during the call, creating verified proof of consent.</div>
          </div>
        </div>

        <div class="flex items-start gap-2.5">
          <div class="w-6 h-6 rounded-full bg-deep-green/10 text-deep-green flex items-center justify-center font-bold shrink-0 mt-0.5">
            &check;
          </div>
          <div>
            <div class="font-bold text-ink-deep">A2P 10DLC Registration</div>
            <div>US and Canada business texting requires carrier registration; Talkera Desk manages your compliance end-to-end.</div>
          </div>
        </div>

        <div class="flex items-start gap-2.5">
          <div class="w-6 h-6 rounded-full bg-deep-green/10 text-deep-green flex items-center justify-center font-bold shrink-0 mt-0.5">
            &check;
          </div>
          <div>
            <div class="font-bold text-ink-deep">Instant STOP Opt-Out</div>
            <div>Strict carrier-grade unsubscribe handling. When a customer replies STOP, dispatches halt immediately.</div>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

<!-- Dual Phone Timeline Logic -->
<script define:vars={{ steps: updates.steps }}>
  const timelineBtns = document.querySelectorAll('.phone-timeline-btn');
  const phoneATime = document.getElementById('phone-a-timestamp');
  const phoneAText = document.getElementById('phone-a-text');
  const phoneBTime = document.getElementById('phone-b-timestamp');
  const phoneBTitle = document.getElementById('phone-b-title');
  const phoneBText = document.getElementById('phone-b-text');

  timelineBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const idx = parseInt(btn.getAttribute('data-step-idx') || '0', 10);
      const data = steps[idx];
      if (!data) return;

      timelineBtns.forEach((b) => {
        b.classList.remove('bg-deep-green', 'text-white', 'shadow-sm', 'hover:bg-brand-green');
        b.classList.add('text-slate', 'hover:text-deep-green', 'hover:bg-white', 'hover:shadow-2xs');
      });
      btn.classList.add('bg-deep-green', 'text-white', 'shadow-sm', 'hover:bg-brand-green');
      btn.classList.remove('text-slate', 'hover:text-deep-green', 'hover:bg-white', 'hover:shadow-2xs');

      if (phoneATime) phoneATime.textContent = `Today ${data.callerMessage.time}`;
      if (phoneAText) phoneAText.textContent = data.callerMessage.text;

      if (phoneBTime) phoneBTime.textContent = `Today ${data.teamMessage.time}`;
      if (phoneBTitle) phoneBTitle.textContent = data.title;
      if (phoneBText) phoneBText.textContent = data.teamMessage.text;
    });
  });
</script>
