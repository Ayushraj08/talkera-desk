---
import pricing from '@content/pricing.json';
---

<section id="pricing" class="py-20 lg:py-28 bg-white border-b border-sky-blue/50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-14 gap-6">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-light-blue border border-sky-blue text-xs font-semibold text-deep-green uppercase tracking-wider font-mono mb-4">
          Transparent Public Rates
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-ink-deep tracking-tight mb-3">
          Pricing at a glance
        </h2>
        <p class="text-sm sm:text-base text-slate leading-relaxed">
          {pricing.datedSentence} Month to month. Cancel anytime with zero penalty.
        </p>
      </div>

      <a
        href="/pricing"
        class="inline-flex items-center gap-2 text-sm font-bold text-deep-green hover:underline shrink-0"
      >
        <span>Open interactive Plan Finder</span>
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>

    <!-- 4 Plan Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
      {pricing.plans.map((pl) => (
          <div class={`rounded-panel p-6 sm:p-7 flex flex-col justify-between transition-all duration-300 relative ${
            pl.highlight
              ? 'bg-deep-green text-white shadow-xl ring-2 ring-lime-accent hover:-translate-y-2 hover:shadow-2xl dark-glass-bezel'
              : 'bg-paper text-ink border border-sky-blue shadow-tactile hover:-translate-y-2 hover:border-deep-green hover:shadow-xl glass-bezel'
          }`}>
            {pl.badge && (
              <div class="absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-0.5 rounded-full bg-lime-accent text-ink-deep text-[11px] font-mono font-bold tracking-wider uppercase shadow-sm">
                {pl.badge}
              </div>
            )}

            <div>
              <div class={`text-xs font-mono uppercase tracking-wider mb-2 font-semibold ${pl.highlight ? 'text-lime-accent' : 'text-brand-green'}`}>
                {pl.name}
              </div>
              <div class="flex items-baseline gap-1 my-3">
                <span class={`text-3xl sm:text-4xl font-extrabold font-heading tabular tracking-tight ${pl.highlight ? 'text-white' : 'text-ink-deep'}`}>
                  ${pl.monthlyFee}
                </span>
                <span class={`text-xs font-mono ${pl.highlight ? 'text-white' : 'text-slate'}`}>
                  / month
                </span>
              </div>
              <p class={`text-xs mb-6 ${pl.highlight ? 'text-white' : 'text-slate'}`}>
                {pl.tagline}
              </p>

              <!-- Metrics Spec (Left text, Right numbers strictly aligned) -->
              <div class={`space-y-2 py-4 border-t border-b text-xs font-mono mb-6 ${pl.highlight ? 'border-white/20' : 'border-sky-blue/60'}`}>
                <div class="flex justify-between items-baseline gap-2 py-0.5">
                  <span class={`text-left shrink-0 ${pl.highlight ? 'text-white' : 'text-slate'}`}>Included Minutes:</span>
                  <span class={`font-bold tabular text-right whitespace-nowrap ${pl.highlight ? 'text-white' : 'text-ink-deep'}`}>{pl.includedMin === 0 ? 'Pay as used' : `${pl.includedMin} mins`}</span>
                </div>
                <div class="flex justify-between items-baseline gap-2 py-0.5">
                  <span class={`text-left shrink-0 ${pl.highlight ? 'text-white' : 'text-slate'}`}>Estimated Calls:</span>
                  <span class={`font-bold tabular text-right whitespace-nowrap ${pl.highlight ? 'text-white' : 'text-ink-deep'}`}>{pl.estimatedCalls}</span>
                </div>
                <div class="flex justify-between items-baseline gap-2 py-0.5">
                  <span class={`text-left shrink-0 ${pl.highlight ? 'text-white' : 'text-slate'}`}>Effective Rate:</span>
                  <span class={`font-bold tabular text-right whitespace-nowrap ${pl.highlight ? 'text-lime-accent' : 'text-brand-green'}`}>
                    {pl.includedMin === 0 ? '$0.600/min' : `$${(pl.monthlyFee / pl.includedMin).toFixed(3)}/min`}
                  </span>
                </div>
                <div class="flex justify-between items-baseline gap-2 py-0.5">
                  <span class={`text-left shrink-0 ${pl.highlight ? 'text-white' : 'text-slate'}`}>Concurrency:</span>
                  <span class={`font-bold tabular text-right whitespace-nowrap ${pl.highlight ? 'text-white' : 'text-ink-deep'}`}>{pl.concurrentCalls === 1 ? '1 call' : `${pl.concurrentCalls} calls`}</span>
                </div>
                <div class="flex justify-between items-baseline gap-2 py-0.5">
                  <span class={`text-left shrink-0 ${pl.highlight ? 'text-white' : 'text-slate'}`}>Setup (1-time):</span>
                  <span class={`font-bold tabular text-right whitespace-nowrap ${pl.highlight ? 'text-white' : 'text-ink-deep'}`}>${pl.setupFee}</span>
                </div>
                <div class={`text-[10px] pt-1.5 border-t ${pl.highlight ? 'border-white/10 text-white font-medium' : 'border-sky-blue/40 text-slate/80'} italic`}>
                  * Calls estimated at ~3 mins average duration.
                </div>
              </div>

              <!-- Features List -->
              <ul class="space-y-2 text-xs mb-8">
                {pl.features.slice(0, 5).map((f) => (
                  <li class="flex items-start gap-2">
                    <span class={`font-bold mt-0.5 ${pl.highlight ? 'text-lime-accent' : 'text-brand-green'}`}>&check;</span>
                    <span class={pl.highlight ? 'text-white' : 'text-slate'}>{f}</span>
                  </li>
                ))}
              </ul>
            </div>

            <a
              href="/pricing"
              class={`w-full py-3 px-4 rounded-full text-xs font-bold text-center transition-all ${
                pl.highlight
                  ? 'bg-lime-accent text-ink-deep hover:bg-[#E5FAA0] shadow'
                  : 'bg-deep-green text-white hover:bg-brand-green'
              }`}
            >
              Select {pl.name}
            </a>
          </div>
      ))}
    </div>

    <!-- "Nothing Hidden" Transparency Box -->
    <div class="bg-paper border border-sky-blue rounded-2xl p-6 sm:p-8 max-w-4xl mx-auto text-xs text-slate">
      <div class="font-heading font-extrabold text-ink-deep text-base mb-3 flex items-center gap-2">
        <svg class="w-5 h-5 text-deep-green" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="16" x2="12" y2="12"/>
          <line x1="12" y1="8" x2="12.01" y2="8"/>
        </svg>
        <span>The Talkera Desk "Nothing Hidden" Promise</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 pt-3 border-t border-sky-blue/60 font-mono">
        <div>
          <span class="font-bold text-ink">Zero Burst Fees:</span>
          <p class="text-[11px] text-slate mt-0.5">Spike callers get free instant SMS & callback holding.</p>
        </div>
        <div>
          <span class="font-bold text-ink">Standard Extra Min:</span>
          <p class="text-[11px] text-slate mt-0.5">$0.60/min across all plans. Never inflated.</p>
        </div>
        <div>
          <span class="font-bold text-ink">20% Rollover:</span>
          <p class="text-[11px] text-slate mt-0.5">Up to 20% unused minutes carry into next cycle.</p>
        </div>
        <div>
          <span class="font-bold text-ink">No Hidden Upkeep:</span>
          <p class="text-[11px] text-slate mt-0.5">Call reviews, monitoring, and fixes fully included.</p>
        </div>
      </div>
    </div>

  </div>
</section>
