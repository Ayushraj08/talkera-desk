---
import faqs from '@content/faq.json';
---

<section id="faq" class="py-20 lg:py-28 bg-[#F8FAFC] border-b border-sky-blue/50">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-2xl mx-auto mb-16">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-ink-deep tracking-tight mb-3">
        Frequently asked questions
      </h2>
      <p class="text-xs sm:text-sm text-slate">
        Written plainly for business owners. Every question opens with a direct answer.
      </p>
    </div>

    <!-- Accordion / Question Cards -->
    <div class="space-y-4" id="home-faq-list">
      {faqs.map((faq, index) => (
        <details
          name="home-faq-accordion"
          class="home-faq-item group bg-white border border-sky-blue rounded-2xl p-6 shadow-2xs open:border-deep-green/60 transition-colors"
          open={index === 0}
        >
          <summary class="font-sans font-bold text-base sm:text-lg text-ink-deep cursor-pointer flex items-center justify-between select-none group-hover:text-deep-green">
            <span>{faq.question}</span>
            <span class="w-7 h-7 rounded-full bg-paper text-deep-green flex items-center justify-center text-sm font-sans group-open:rotate-180 transition-transform shrink-0 ml-4">
              &darr;
            </span>
          </summary>
          <div class="mt-4 pt-4 border-t border-sky-blue/40 text-xs sm:text-sm text-slate leading-relaxed">
            <p>{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>

  </div>
</section>

<script>
  const homeFaqs = document.querySelectorAll<HTMLDetailsElement>('details.home-faq-item');
  homeFaqs.forEach((detail) => {
    detail.addEventListener('toggle', () => {
      if (detail.open) {
        homeFaqs.forEach((other) => {
          if (other !== detail && other.open) {
            other.open = false;
          }
        });
      }
    });
  });
</script>
