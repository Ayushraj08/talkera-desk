---
const facts = [
  {
    label: '24/7 voice answering',
    text: 'Answers on the second ring, day or night, with natural conversation.',
  },
  {
    label: 'Automated booking',
    text: 'Books appointments into your calendar or CRM and secures customer intake.',
  },
  {
    label: 'Instant crew alerts',
    text: 'Texts confirmation to your caller and alerts your on-call technician immediately.',
  },
];
---

<section class="bg-white py-8 sm:py-10 border-b border-sky-blue/50" aria-label="What Talkera Desk does">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6">
      {facts.map((fact) => (
        <article class="rounded-2xl border border-sky-blue bg-paper px-6 py-5 sm:px-7 sm:py-6">
          <h2 class="text-xs uppercase tracking-widest text-brand-green font-bold font-sans mb-3">{fact.label}</h2>
          <p class="text-base font-semibold leading-relaxed text-ink-deep">{fact.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
