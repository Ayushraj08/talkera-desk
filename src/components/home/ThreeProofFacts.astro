---
// Section 2: Three Proof Facts (one line each, clean and premium)
const proofs = [
  {
    tag: '24/7 Voice Answering',
    fact: 'Answers on the second ring, day or night, with natural conversation.',
  },
  {
    tag: 'Automated Booking',
    fact: 'Books appointments into your calendar or CRM and secures customer intake.',
  },
  {
    tag: 'Instant Crew Alerts',
    fact: 'Texts confirmation to your caller and alerts your on-call technician immediately.',
  }
];
---

<section class="py-10 bg-white border-b border-sky-blue/50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {proofs.map((p) => (
        <div class="p-6 rounded-2xl bg-paper border border-sky-blue shadow-2xs flex flex-col justify-between">
          <span class="text-[11px] font-mono uppercase font-bold text-brand-green tracking-wider mb-2">
            {p.tag}
          </span>
          <p class="text-sm font-semibold text-ink-deep leading-snug">
            {p.fact}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
