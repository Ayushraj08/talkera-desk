---
// Section 4: Everyone stays in the loop (Horizontal animated workflow: ringing -> answer -> intake -> booked)
---

<section class="py-14 lg:py-20 bg-[#F4F8FA] border-b border-sky-blue/60 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-10">
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-ink-deep tracking-tight font-heading">
        Everyone stays in the loop
      </h2>
    </div>

    <!-- Horizontal Connected Pipeline (4 Steps) -->
    <div class="relative">
      
      <!-- Connecting Track Line (Desktop) -->
      <div class="hidden lg:block absolute top-7 left-[10%] right-[10%] h-0.5 bg-sky-blue -z-0">
        <div id="flow-progress" class="h-full bg-gradient-to-r from-deep-green via-brand-green to-lime-accent w-1/4 transition-all duration-700 ease-out"></div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5 relative z-10" id="workflow-grid">
        
        <!-- Step 1: Call Rings -->
        <div class="workflow-card active p-5 rounded-2xl bg-white border-2 border-deep-green shadow-md transition-all duration-300 cursor-pointer flex flex-col justify-between" data-step="0">
          <div>
            <div class="flex items-center justify-between mb-3">
              <div class="w-10 h-10 rounded-xl bg-deep-green text-lime-accent flex items-center justify-center font-mono font-bold text-sm shadow-sm relative">
                <svg class="w-5 h-5 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
                <span class="absolute -top-1 -right-1 flex h-2.5 w-2.5">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
                </span>
              </div>
              <span class="text-[11px] font-mono text-slate font-bold">00:00</span>
            </div>
            <h3 class="font-heading font-bold text-base text-ink-deep">1. Call Rings</h3>
            <p class="text-xs text-slate mt-1 leading-relaxed">Answers on second ring, 24/7.</p>
          </div>
        </div>

        <!-- Step 2: AI Answers -->
        <div class="workflow-card p-5 rounded-2xl bg-paper border border-sky-blue hover:border-deep-green/40 transition-all duration-300 cursor-pointer flex flex-col justify-between" data-step="1">
          <div>
            <div class="flex items-center justify-between mb-3">
              <div class="w-10 h-10 rounded-xl bg-paper text-deep-green border border-sky-blue flex items-center justify-center font-mono font-bold text-sm">
                <div class="flex items-center gap-0.5 h-4">
                  <span class="w-1 h-2 bg-deep-green rounded-full animate-pulse"></span>
                  <span class="w-1 h-4 bg-brand-green rounded-full animate-pulse delay-75"></span>
                  <span class="w-1 h-3 bg-deep-green rounded-full animate-pulse delay-150"></span>
                </div>
              </div>
              <span class="text-[11px] font-mono text-slate font-bold">00:02</span>
            </div>
            <h3 class="font-heading font-bold text-base text-ink-deep">2. AI Answers</h3>
            <p class="text-xs text-slate mt-1 leading-relaxed">Converses naturally, triages caller.</p>
          </div>
        </div>

        <!-- Step 3: Smart Intake -->
        <div class="workflow-card p-5 rounded-2xl bg-paper border border-sky-blue hover:border-deep-green/40 transition-all duration-300 cursor-pointer flex flex-col justify-between" data-step="2">
          <div>
            <div class="flex items-center justify-between mb-3">
              <div class="w-10 h-10 rounded-xl bg-paper text-deep-green border border-sky-blue flex items-center justify-center font-mono font-bold text-sm">
                <svg class="w-5 h-5 text-deep-green" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                </svg>
              </div>
              <span class="text-[11px] font-mono text-slate font-bold">00:15</span>
            </div>
            <h3 class="font-heading font-bold text-base text-ink-deep">3. Smart Intake</h3>
            <p class="text-xs text-slate mt-1 leading-relaxed">Captures address, holds calendar slot.</p>
          </div>
        </div>

        <!-- Step 4: Booked & SMS Dispatch -->
        <div class="workflow-card p-5 rounded-2xl bg-paper border border-sky-blue hover:border-deep-green/40 transition-all duration-300 cursor-pointer flex flex-col justify-between" data-step="3">
          <div>
            <div class="flex items-center justify-between mb-3">
              <div class="w-10 h-10 rounded-xl bg-paper text-deep-green border border-sky-blue flex items-center justify-center font-mono font-bold text-sm">
                <svg class="w-5 h-5 text-deep-green" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                </svg>
              </div>
              <span class="text-[11px] font-mono text-slate font-bold">00:28</span>
            </div>
            <h3 class="font-heading font-bold text-base text-ink-deep">4. Job Booked</h3>
            <p class="text-xs text-slate mt-1 leading-relaxed">Texts caller and dispatches crew.</p>
          </div>
        </div>

      </div>
    </div>

    <!-- Live Preview Stage: Interactive Dispatch Stream -->
    <div class="mt-8 max-w-xl mx-auto rounded-2xl bg-white border border-sky-blue p-4 shadow-tactile">
      <div class="space-y-2 text-xs font-mono">
        <div class="p-2.5 rounded-lg bg-paper border border-sky-blue/70 flex items-center justify-between gap-3">
          <span class="text-ink-deep font-sans">3:00 AM slot booked. Mike dispatched.</span>
          <span class="text-[10px] text-slate font-mono shrink-0">02:15 AM</span>
        </div>
        <div class="p-2.5 rounded-lg bg-paper border border-sky-blue/70 flex items-center justify-between gap-3">
          <span class="text-ink-deep font-sans">Mike is 15 mins away in van #4.</span>
          <span class="text-[10px] text-slate font-mono shrink-0">02:40 AM</span>
        </div>
      </div>
    </div>

  </div>
</section>

<!-- Auto-Looping Step Animation Script -->
<script>
  const cards = document.querySelectorAll<HTMLElement>('.workflow-card');
  const progress = document.getElementById('flow-progress');
  let currentStep = 0;
  const totalSteps = cards.length;

  function setActiveStep(stepIndex: number) {
    cards.forEach((card, idx) => {
      if (idx === stepIndex) {
        card.classList.remove('bg-paper', 'border-sky-blue');
        card.classList.add('bg-white', 'border-2', 'border-deep-green', 'shadow-md');
        const iconDiv = card.querySelector('.w-10');
        if (iconDiv && idx > 0) {
          iconDiv.classList.add('bg-deep-green', 'text-lime-accent');
          iconDiv.classList.remove('bg-paper', 'text-deep-green');
        }
      } else {
        card.classList.remove('bg-white', 'border-2', 'border-deep-green', 'shadow-md');
        card.classList.add('bg-paper', 'border-sky-blue');
        const iconDiv = card.querySelector('.w-10');
        if (iconDiv && idx > 0) {
          iconDiv.classList.remove('bg-deep-green', 'text-lime-accent');
          iconDiv.classList.add('bg-paper', 'text-deep-green');
        }
      }
    });

    if (progress) {
      const pct = ((stepIndex + 1) / totalSteps) * 100;
      progress.style.width = `${pct}%`;
    }
  }

  // Interactive Click to view any step
  cards.forEach((card) => {
    card.addEventListener('click', () => {
      const step = Number(card.getAttribute('data-step') || 0);
      currentStep = step;
      setActiveStep(currentStep);
    });
  });

  // Smooth Auto-Looping Highlight every 3 seconds
  setInterval(() => {
    currentStep = (currentStep + 1) % totalSteps;
    setActiveStep(currentStep);
  }, 3200);
</script>
