---
import site from '@content/site.json';
---

<section class="py-20 lg:py-28 bg-deep-green text-white relative noise-overlay overflow-hidden">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
    
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 border border-white/15 text-xs font-semibold text-lime-accent uppercase tracking-wider font-mono mb-6">
      Live Answering In Up To 3 Days
    </div>

    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight max-w-3xl mx-auto mb-6">
      Ready to turn every missed call into a booked job?
    </h2>

    <p class="text-base sm:text-lg text-gray-200 leading-relaxed max-w-2xl mx-auto mb-10">
      We build it, connect it to your tools, run it 24/7, and review the calls. Month to month, no contract, and transparent public rates starting from $59 a month.
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-8">
      <a
        href="#demos"
        class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-full text-base font-bold bg-lime-accent text-ink hover:bg-[#E5FAA0] transition-all transform hover:-translate-y-0.5 active:translate-y-0 shadow-lg"
      >
        <span>Hear it work</span>
        <svg class="w-4 h-4 ml-2 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>

      <a
        href="mailto:support@talkeradesk.com"
        class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-full text-base font-semibold text-white border border-white/30 hover:bg-white/10 transition-all"
      >
        Book a 15 min call
      </a>
    </div>

    <div class="flex flex-wrap items-center justify-center gap-6 text-xs text-gray-300 font-mono">
      <span>Email: <a href={`mailto:${site.supportEmail}`} class="text-lime-accent hover:underline">{site.supportEmail}</a></span>
      <span>&bull;</span>
      <span>WhatsApp: <a href={`https://wa.me/${site.whatsapp.replace(/[^0-9]/g, '')}`} class="text-lime-accent hover:underline">{site.whatsappFormatted}</a></span>
    </div>

  </div>
</section>
