---
---

<section class="hero-stage text-white pt-12 pb-20 lg:pt-16 lg:pb-28 relative noise-overlay">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Editorial Headline & Actions -->
      <div class="lg:col-span-7 flex flex-col justify-center">
        <!-- Eyebrow Pill -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/10 border border-white/15 backdrop-blur-md w-max mb-6">
          <span class="w-2 h-2 rounded-full bg-lime-accent animate-ping"></span>
          <span class="text-xs font-semibold text-lime-accent tracking-wide uppercase font-mono">Turning missed calls into business</span>
        </div>

        <!-- H1 Headline (Exact words from Update pack Hero wording) -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight leading-[1.04] mb-6 font-heading">
          AI receptionist that answers every call, 24/7.
        </h1>

        <!-- Subhead (Exact words from Update pack Hero wording) -->
        <p class="text-lg sm:text-xl text-gray-200 leading-relaxed font-normal max-w-2xl mb-8">
          Talkera Desk is an AI receptionist for your business. It answers your phone day and night, even when you are asleep, busy or on a job. It books the appointment into your calendar and texts you the details, so the caller never lands in voicemail and then books your competitor. We build it around your business in up to 3 days.
        </p>


        <!-- Action Buttons (Kept exactly as built) -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 mb-6">
          <a
            href="/demo"
            class="inline-flex items-center justify-center px-8 py-4 rounded-full text-base font-bold bg-lime-accent text-ink hover:bg-[#E5FAA0] transition-all transform hover:-translate-y-0.5 active:translate-y-0 shadow-lg shadow-lime-accent/20 font-heading"
          >
            <span>Hear it work</span>
            <svg class="w-4 h-4 ml-2 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
          <a
            href={site.bookingUrl} target="_blank" rel="noopener noreferrer"
            class="inline-flex items-center justify-center px-8 py-4 rounded-full text-base font-semibold text-white border border-white/30 hover:bg-white/10 transition-all font-heading"
          >
            Book a 15 min call
          </a>
        </div>

        <p class="text-xs text-gray-400 leading-normal max-w-xl font-mono">
          Answers almost every call. Up to 3 days to live.
        </p>
      </div>

      <!-- Right Column: Interactive Call Card (Kept exactly as built) -->
      <div class="lg:col-span-5">
        <div class="mercury-shell-dark">
          <div class="mercury-inner bg-[#0B3528] border border-white/10 p-5 sm:p-6 text-white rounded-3xl shadow-2xl">
            <div class="flex items-center justify-between pb-4 border-b border-white/10 mb-5">
              <div class="flex items-center gap-2.5">
                <span class="relative flex h-3 w-3">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
                </span>
                <div>
                  <div class="text-xs font-mono font-bold text-white uppercase tracking-wider">Simulated Inbound Call</div>
                  <div class="text-[11px] text-gray-400 font-mono">Caller: John &bull; 02:14 AM &bull; Burst Pipe</div>
                </div>
              </div>
              <div class="font-mono text-xs px-2.5 py-1 rounded bg-white/10 text-lime-accent font-semibold tabular">
                00:18
              </div>
            </div>

            <div class="space-y-3 mb-5">
              <div class="flex items-start gap-2.5">
                <div class="w-6 h-6 rounded-md bg-lime-accent/20 text-lime-accent flex items-center justify-center text-[10px] font-bold font-mono shrink-0 mt-0.5">
                  AI
                </div>
                <div class="bg-white/10 border border-white/10 rounded-2xl rounded-tl-sm px-3.5 py-2 text-xs text-gray-200 leading-relaxed max-w-[85%]">
                  "Hi John, Talkera Desk here for Apex Restoration. Recorded call. Is anyone in danger?"
                </div>
              </div>
              <div class="flex items-start gap-2.5 justify-end">
                <div class="bg-brand-green/40 border border-emerald-500/30 rounded-2xl rounded-tr-sm px-3.5 py-2 text-xs text-white leading-relaxed max-w-[85%]">
                  "No danger, but water is pouring from our ceiling. Can you send someone?"
                </div>
              </div>
              <div class="flex items-start gap-2.5">
                <div class="w-6 h-6 rounded-md bg-lime-accent/20 text-lime-accent flex items-center justify-center text-[10px] font-bold font-mono shrink-0 mt-0.5">
                  AI
                </div>
                <div class="bg-white/10 border border-white/10 rounded-2xl rounded-tl-sm px-3.5 py-2 text-xs text-gray-200 leading-relaxed max-w-[85%]">
                  "Shut off the main valve if safe. 3:00 AM slot held and Mike dispatched. Texting confirmation now."
                </div>
              </div>
            </div>

            <div class="p-3.5 rounded-xl bg-white/5 border border-white/10 flex items-center justify-between text-xs font-mono">
              <span class="text-gray-300">Calendar & SMS Dispatch:</span>
              <span class="text-lime-accent font-bold">Slot Held &bull; Confirmed</span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
