---
import site from '@content/site.json';
---

<section id="founder" class="py-20 lg:py-28 bg-white border-b border-sky-blue/50">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="mercury-shell-light">
      <div class="mercury-inner bg-paper border border-sky-blue p-5 sm:p-8 md:p-12">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-10 items-stretch">
          
          <!-- Avatar & Badge (Left Col - stretches full height) -->
          <div class="md:col-span-4 flex flex-col justify-between items-center md:items-start text-center md:text-left h-full">
            <div class="flex flex-col items-center md:items-start w-full">
              <img
                src="/images/ayush-raj.jpg"
                alt="Ayush Raj - Founder, DRUVA GROUP"
                class="w-36 h-36 sm:w-48 sm:h-48 md:w-52 md:h-52 rounded-3xl object-cover object-top shadow-md mb-4 border-2 border-white ring-2 ring-deep-green/20"
                loading="lazy"
              />
              <h3 class="font-heading font-extrabold text-2xl text-ink-deep">
                Ayush Raj
              </h3>
              <div class="text-xs font-sans text-brand-green font-bold mt-1">
                Founder &bull; {site.enterpriseName}
              </div>
            </div>

            <div class="w-full mt-6 pt-4 border-t border-sky-blue/70 font-sans text-xs text-slate">
              <div class="text-ink font-semibold flex items-center justify-center md:justify-start gap-1.5">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                <span>Operational Base: Kolkata</span>
              </div>
              <div class="text-[11px] text-gray-500 mt-1">
                Direct prompt & model engineering
              </div>
            </div>
          </div>

          <!-- Editorial Transparency Copy (Right Col - stretches full height) -->
          <div class="md:col-span-8 flex flex-col justify-between h-full space-y-5 text-xs sm:text-sm text-slate leading-relaxed">
            <div>
              <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-deep-green/10 text-deep-green text-xs font-sans font-bold mb-3">
                Complete Transparency
              </div>
              <h4 class="font-heading font-bold text-xl sm:text-2xl text-ink-deep leading-snug mb-3">
                Why we state our registration and India-based team plainly.
              </h4>
              <p class="mb-3">
                Talkera Desk is a specialized brand of <strong class="text-ink-deep">{site.enterpriseName}</strong>, a registered sole proprietorship founded by Ayush Raj. DRUVA GROUP began operations on 15 April 2026, and Talkera Desk was launched on 1 September 2026 to serve home service and restoration businesses in the US, UK, Canada, Australia, and India.
              </p>
              <p>
                Our engineering and operations team operates from our verified base in Kolkata (2nd floor, Gitanjali Apartment, Kisan Market, E.K.T, Hussainpur Road, Kolkata 700107). Working directly with our technical team means you get handcrafted voice prompt engineering, dedicated call audits, and direct support without the inflated pricing of US middleman vendors.
              </p>
            </div>

            <!-- Verification Table (bottom aligned) -->
            <div class="pt-4 border-t border-sky-blue/70 grid grid-cols-1 sm:grid-cols-2 gap-3 font-sans text-xs">
              <div class="p-3.5 rounded-xl bg-white border border-sky-blue shadow-2xs">
                <span class="text-gray-400 block text-[10px] uppercase font-bold">Udyam Registration</span>
                <span class="font-bold text-ink-deep text-sm font-sans whitespace-nowrap">{site.udyamNumber}</span>
                <a href={site.udyamVerificationUrl} target="_blank" rel="noopener noreferrer" class="block text-[11px] text-deep-green underline font-semibold mt-1">Verify at Government Portal &rarr;</a>
              </div>
              <div class="p-3.5 rounded-xl bg-white border border-sky-blue shadow-2xs">
                <span class="text-gray-400 block text-[10px] uppercase font-bold">Active Issued GSTIN</span>
                <span class="font-bold text-ink-deep text-sm font-sans whitespace-nowrap">{site.gstin}</span>
                <a href={site.gstVerificationUrl} target="_blank" rel="noopener noreferrer" class="block text-[11px] text-deep-green underline font-semibold mt-1">Verify at GST Portal &rarr;</a>
              </div>
            </div>

          </div>

        </div>
      </div>
    </div>

  </div>
</section>
