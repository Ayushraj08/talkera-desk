{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.talkeradesk.com"
        }
      ],
      "destination": "https://talkeradesk.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "talkera-desk.vercel.app"
        }
      ],
      "destination": "https://talkeradesk.com/:path*",
      "permanent": true
    }
  ]
}
